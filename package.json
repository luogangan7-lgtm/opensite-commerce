{
  "name": "opensite-commerce",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "web/*",
    "packages/*"
  ],
  "scripts": {
    "tokens:generate": "bun packages/design-tokens/generate.ts",
    "tokens:check": "bun packages/design-tokens/generate.ts --check",
    "typecheck": "./node_modules/typescript/bin/tsc --noEmit",
    "lint:styles": "bun scripts/frontend/lint-styles.ts",
    "contrast": "bun scripts/frontend/check-contrast.ts",
    "test:frontend": "bun test scripts/frontend",
    "build:admin": "vite build --config web/admin/vite.config.ts web/admin",
    "build:gallery": "vite build --config web/admin/vite.config.ts web/admin --mode gallery --outDir dist-gallery",
    "visual:test": "playwright test",
    "visual:update": "bun scripts/frontend/update-baselines.ts",
    "frontend:check": "bash scripts/check_frontend.sh",
    "build:storefront": "bun run --filter @opensite/storefront build",
    "start:storefront": "bash scripts/start_storefront_ssr.sh",
    "check:storefront": "bun run --filter @opensite/storefront check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.3.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "typescript-parser": "npm:typescript@6.0.3",
    "vite": "8.3.4"
  }
}
