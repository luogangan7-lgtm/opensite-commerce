---
/** Responsibility: private/no-store captured-only receipt document; dependencies: SSR purchase context + completion island. */
import Shell from '../layouts/Shell.astro';
import CompletionPage from '../components/CompletionPage';
import { readPurchaseContext } from '../lib/commerce-server';
import { commerceCopy } from '../lib/commerce-copy';
import { requestCanonical } from '../lib/host-policy';
const context = await readPurchaseContext(Astro.request, Astro.cookies);
const ui = commerceCopy();
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Shell homeHref="/" title={ui.orderConfirmation} description={ui.purchaseDescription} canonical={requestCanonical(Astro)} noindex navigation={[{ label: ui.browseProducts, href: '/products' }]}>
  <h1>{ui.orderConfirmation}</h1><CompletionPage context={context} client:load />
</Shell>
