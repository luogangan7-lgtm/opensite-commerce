---
/** Responsibility: native Astro unknown-route response; dependency: error composition. */
import ErrorPage from '../components/ErrorPage.astro';
import { requestCanonical } from '../lib/host-policy';
Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<ErrorPage status={404} canonical={requestCanonical(Astro)} />
