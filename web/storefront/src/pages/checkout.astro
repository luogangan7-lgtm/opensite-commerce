---
/** Responsibility: private/no-store checkout document; dependencies: SSR purchase context + checkout island. */
import Shell from '../layouts/Shell.astro';
import CheckoutPage from '../components/CheckoutPage';
import { readPurchaseContext } from '../lib/commerce-server';
import { commerceCopy } from '../lib/commerce-copy';
import { requestCanonical } from '../lib/host-policy';
const context = await readPurchaseContext(Astro.request, Astro.cookies);
const ui = commerceCopy();
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Shell title={ui.checkout} description={ui.purchaseDescription} canonical={requestCanonical(Astro)} noindex navigation={[{ label: ui.browseProducts, href: '/products' }]}>
  <h1>{ui.checkout}</h1><CheckoutPage context={context} client:load />
</Shell>
