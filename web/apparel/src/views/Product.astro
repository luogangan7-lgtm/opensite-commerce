---
/** PDP consumes static product facts plus committed translations; MOQ uses owner facts; other commercial fields use quote text. */
import Shell from '../layouts/Shell.astro';
import { pdpMoq } from '../data/owner-facts';
import RFQ from '../components/RFQ.astro';
import ProductGallery from '../components/ProductGallery.astro';
import { productSizeChart, visibleChartSizes } from '../data/size-charts';
import { products, type Product } from '../data/catalog';
import Grid from '../components/Grid.astro';
import { pdpMediaPair, orderedGallery, primaryColour } from '../data/gallery';
import { digitalAlt } from '../data/imagery';
import { dictionaries, pageLocale, productText, type Key } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
interface Props { product: Product }
const { product } = Astro.props;
const locale = pageLocale(Astro.url), t = dictionaries[locale], text = productText[locale][product.slug];
const primary = primaryColour(product.images);
const inquiryUrl = (type: 'quote' | 'sample') => `${getRelativeLocaleUrl(locale, '/contact/')}?${new URLSearchParams({ product: product.slug, type, colour: primary || '' })}#rfq-form`;
const gallery = orderedGallery(product.images);
const mediaPair = pdpMediaPair(product.images);
const fabric = product.images.find(image => image.role === 'fabric' && image.colour === primary);
const chart = productSizeChart(product.slug);
const measurements: Record<string, Key> = { length:'pdpLength', chest:'pdpChest', shoulder:'pdpShoulder', sleeve:'pdpSleeve', sleeve_width:'pdpSleeveWidth', rib_height:'pdpRib', sleeve_opening:'pdpSleeveOpening', hem:'pdpHem', weight_jin:'pdpWeight', top_length:'pdpTopLength', top_chest:'pdpTopChest', top_shoulder:'pdpShoulder', top_sleeve:'pdpSleeve', pants_waist:'pdpWaist', pants_hip:'pdpHip', pants_length:'pdpPantsLength' };
const quickSpecs = [[t.pdpStyle, product.style_codes.join(' / ') || text.name], [t.pdpCategory, t[product.category as Key]], [t.pdpFabric, text.fabric_weight_fit], [t.moq, pdpMoq[locale]], ...(chart ? [[t.pdpSize, visibleChartSizes(chart).map(({size}) => size).join(' · ')]] : [])];
const fullSpecs = [...quickSpecs, [t.productViews, text.colourway_note], ...['price','leadTime','sampleCost'].map(field => [t[field as Key], t.quote])];
const alt = (image: typeof gallery[number], index: number) => digitalAlt(image.src, locale) || `${text.name}: ${t.view} ${index + 1}`;
const lcpMobile = digitalAlt(gallery[0].src, locale) ? gallery[0].src.replace(/\.webp$/, '-640.webp') : undefined;
// Keep the adopted related identity first, excluding the current PDP.
const related = products.filter(p => p.category === product.category && p.slug !== product.slug);
const featuredRelated = related.find(p => p.slug === 'apparel-70171');
const relatedCards = (featuredRelated ? [featuredRelated, ...related.filter(p => p !== featuredRelated)] : related).slice(0, 4);
---
<Shell title={text.name} lcpImage={gallery[0].src} lcpMobile={lcpMobile}>
<section class="wrap pdp-section"><a href={getRelativeLocaleUrl(locale, `/collections/${product.category}/`)}>{t[product.category as Key]}</a><div class="pdp split"><ProductGallery product={product} /><div class="product-info"><h1>{text.name}</h1><p class="muted">{t.pdpStyle} · <bdi>{product.style_codes.join(' / ')}</bdi></p><p>{text.fabric_weight_fit}</p><p class="moq-line" data-commercial>{pdpMoq[locale]}</p><div class="actions"><a class="button" data-rfq-intent="quote" href={inquiryUrl('quote')}>{t.request}</a><a class="button secondary" data-rfq-intent="sample" href={inquiryUrl('sample')}>{t.requestSample}</a></div><p>{text.colourway_note}</p><table data-quick-spec><caption>{t.pdpQuick}</caption><tbody>{quickSpecs.map(([label,value]) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table>{chart && <a href="#size-chart">{t.sizeChart}</a>}<p class="muted">{t.specText}</p></div></div></section>
<section class="wrap split pdp-details"><div><h2>{t.pdpDetails}</h2><p>{text.name}</p><p>{text.fabric_weight_fit}</p><p>{text.colourway_note}</p></div><table data-full-spec><caption>{t.pdpSpecs}</caption><tbody>{fullSpecs.map(([label,value]) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table></section>
<section class="pdp-fabric"><div class="wrap"><h2>{t.pdpFabric}</h2>
  <div class="pdp-media" data-pdp-media><div class="pdp-media-pair">
    {fabric && <img data-pdp-fabric src={fabric.src} alt={alt(fabric, gallery.indexOf(fabric))} width="1200" height="1200" loading="lazy" decoding="async" />}
    <figure class="pdp-detail-card"><img data-pdp-detail src={mediaPair.detail.src} alt={alt(mediaPair.detail, gallery.indexOf(mediaPair.detail))} width="1200" height="1200" loading="lazy" decoding="async" /></figure>
  </div></div><p>{t.specText}</p>
</div></section>
{chart && <section class="wrap" id="size-chart"><h2>{t.sizeChart}</h2><div class="size-table-scroll" role="region" aria-label={t.sizeChart} tabindex="0"><table data-size-table><caption>{t.sizeChart} · {chart.unit}</caption><thead><tr><th scope="col">{t.pdpSize}</th>{Object.keys(chart.rows).map(key => <th scope="col" data-measurement={key}>{t[measurements[key]]}</th>)}</tr></thead><tbody>{visibleChartSizes(chart).map(({size,index}) => <tr><th scope="row"><bdi>{size}</bdi></th>{Object.entries(chart.rows).map(([key,values]) => <td data-measurement={key}><bdi>{values[index] ?? '—'}</bdi></td>)}</tr>)}</tbody></table></div></section>}
<section class="wrap split" id="inquiry"><div><h2>{t.makeYours}</h2><p>{t.briefText}</p></div><RFQ product={product.style_codes.join(' / ')} /></section>
<section class="wrap"><div class="section-heading"><h2>{t.pdpRelated}</h2><a href={getRelativeLocaleUrl(locale, `/collections/${product.category}/`)}>{t.viewCollection}</a></div><Grid products={relatedCards} /></section>
</Shell>


<style>
  /* FD1 Gallery G-detail variants; existing tokens, primary-colour media only. */
  .pdp-detail-card { margin: var(--sy-space-0); }
  .pdp-media-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sy-space-grid-x); align-items: start; }
  .pdp-media img { width: 100%; object-fit: contain; border-radius: var(--sy-radius-image); }
  .gallery > picture > img { border-radius: var(--sy-radius-inner); aspect-ratio: 4 / 5; object-fit: contain; object-position: 50% 0; }
  [data-pdp-detail], [data-pdp-fabric] { aspect-ratio: 1; }
  .gallery { display: flex; flex-direction: column; gap: var(--sy-space-md); align-self: start; }
  .gallery > picture { display: block; padding: var(--sy-space-photo-pad); border-radius: var(--sy-radius-card); background: var(--sy-color-surface); box-shadow: var(--sy-shadow-card); }
  .gallery > button { align-self: start; }
  .gallery-thumbs { flex-wrap: nowrap; align-items: start; overflow-y: hidden; }
  .gallery-thumbs img { width: 64px; height: 80px; }
  @media (min-width: 1101px) { .gallery { position: sticky; top: var(--sy-space-lg); } }
  .gallery-colours button { background: var(--sy-color-canvas); border-color: var(--sy-color-border); border-radius: var(--sy-radius-image); }
  .gallery-colours img, .gallery-thumbs img { object-fit: contain; }
  .gallery-thumbs [data-fit="contain"] img { aspect-ratio: 1; }
  .product-info { display: flex; flex-direction: column; gap: var(--sy-space-group); }
  .product-info h1 { font-size: var(--sy-text-h3); font-weight: var(--sy-weight-body); }
  .pdp-details h2, .pdp-fabric h2, #size-chart h2 { font-size: var(--sy-text-h4); font-weight: var(--sy-weight-body); }
  .product-info .actions { display: grid; }
  .product-info p, .product-info h1, .product-info h2, .product-info table { margin: var(--sy-space-0); }
  .moq-line { padding: var(--sy-space-md); background: var(--sy-color-surface-alt); }
  .pdp-details { border-block-start: var(--sy-space-hair) solid var(--sy-color-hairline); }
  .pdp-fabric { background: var(--sy-color-surface-alt); color: var(--sy-color-ink); }
  .size-table-scroll { overflow-x: auto; }
  .size-table-scroll th, .size-table-scroll td { padding-inline-end: var(--sy-space-lg); white-space: nowrap; }
  .eyebrow { font-family: var(--sy-font-body); font-size: var(--sy-text-eyebrow); }
  @media (max-width: 1100px) { .pdp, .pdp-details { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 767px) { .pdp-media-pair { grid-template-columns: minmax(0, 1fr); } }
</style>
