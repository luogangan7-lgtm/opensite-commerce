---
/** PDP consumes static product facts plus committed translations; MOQ uses owner facts; other commercial fields use quote text. */
import Shell from '../layouts/Shell.astro';
import { pdpMoq } from '../data/owner-facts';
import ProductGallery from '../components/ProductGallery.astro';
import { chartWeight, productSizeChart, visibleChartSizes } from '../data/size-charts';
import { products, type Product } from '../data/catalog';
import ProductCard from '../components/ProductCard.astro';
import { orderedGallery, primaryColour } from '../data/gallery';
import { digitalAlt } from '../data/imagery';
import { dictionaries, pageLocale, productText, type Key } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
interface Props { product: Product }
const { product } = Astro.props;
const locale = pageLocale(Astro.url), t = dictionaries[locale], text = productText[locale][product.slug];
const primary = primaryColour(product.images);
const inquiryUrl = (type: 'quote' | 'sample') => `${getRelativeLocaleUrl(locale, '/contact/')}?${new URLSearchParams({ product: product.slug, type, colour: primary || '' })}#rfq-form`;
const gallery = orderedGallery(product.images);
const chart = productSizeChart(product.slug);
const weightUnit = t.pdpWeightUnit;
const isFeaturedHoodie = product.slug === 'cotton430-hoodie-58065';
const tolerance = chart && 'tolerance' in chart ? chart.tolerance.match(/±\d+-\d+/)?.[0].replace('-', '–') : isFeaturedHoodie ? '±1–2' : undefined;
const measurements: Record<string, Key> = { length:'pdpLength', chest:'pdpChest', shoulder:'pdpShoulder', sleeve:'pdpSleeve', sleeve_width:'pdpSleeveWidth', rib_height:'pdpRib', sleeve_opening:'pdpSleeveOpening', hem:'pdpHem', weight_jin:'pdpBodyWeight', top_length:'pdpTopLength', top_chest:'pdpTopChest', top_shoulder:'pdpShoulder', top_sleeve:'pdpSleeve', pants_waist:'pdpWaist', pants_hip:'pdpHip', pants_length:'pdpPantsLength' };
const sizes = chart ? visibleChartSizes(chart).map(({ size }) => size) : [];
const sizeRange = sizes.length > 1 ? `${sizes[0]}–${sizes.at(-1)}` : sizes[0];
const fullSpecs = [
  [t.pdpGarment, isFeaturedHoodie ? t.pdp58065Garment : t[product.category as Key]],
  ...(sizeRange ? [[t.pdpChartSizes, sizeRange + (locale === 'zh' ? ' 码' : '')]] : []),
  [t.pdpShownColour, isFeaturedHoodie ? t.pdp58065Colour : text.colourway_note],
  [t.pdpFabric, isFeaturedHoodie ? t.pdp58065Fabric : text.fabric_weight_fit],
  [t.pdpFabricWeight, t.pdpQuoteConfirmed],
];
const lcpMobile = digitalAlt(gallery[0].src, locale) ? gallery[0].src.replace(/\.webp$/, '-640.webp') : undefined;
// Keep the adopted related identity first, excluding the current PDP.
const related = products.filter(p => p.category === product.category && p.slug !== product.slug);
const featuredRelated = related.find(p => p.slug === 'apparel-70171');
const relatedCards = isFeaturedHoodie
  ? ['58063', '58064', '58066', '70046'].flatMap(code => related.filter(item => item.style_codes.includes(code)))
  : (featuredRelated ? [featuredRelated, ...related.filter(p => p !== featuredRelated)] : related).slice(0, 4);
---
<Shell title={text.name} lcpImage={gallery[0].src} lcpMobile={lcpMobile}>
<section class="wrap pdp-section">
  <nav class="pdp-breadcrumb" aria-label={t.collections}>
    <a href={getRelativeLocaleUrl(locale, '/collections/')}>{t.collections}</a> /
    <a href={getRelativeLocaleUrl(locale, `/collections/${product.category}/`)}>{t[product.category as Key]}</a> /
    <bdi>{product.style_codes.join(' / ')}</bdi>
  </nav>
  <div class="pdp split">
    <ProductGallery product={product} />
    <div class="product-info">
      <h1>{isFeaturedHoodie ? t.pdp58065Title : text.name}</h1>
      <p class="muted">{t.pdpStyle} <bdi>{product.style_codes.join(' / ')}</bdi></p>
      <p>{isFeaturedHoodie ? t.pdp58065Subtitle : text.fabric_weight_fit}</p>
      <p class="moq-line" data-commercial>{pdpMoq[locale]}</p>
      <div class="actions">
        <a class="button" data-rfq-intent="quote" href={inquiryUrl('quote')}>{t.request}</a>
        <a class="button secondary" data-rfq-intent="sample" href={inquiryUrl('sample')}>{t.requestSample}</a>
      </div>
      {isFeaturedHoodie && <p>{t.pdpFinishOnRequest}</p>}
      <p>{isFeaturedHoodie ? t.pdp58065QuoteTiming : text.colourway_note}</p>
    </div>
  </div>
</section>
<section class="wrap split pdp-details"><div class="pdp-details-copy"><h2>{t.pdpDetails}</h2><p>{isFeaturedHoodie ? t.pdp58065Description : text.name}</p><p>{isFeaturedHoodie ? t.pdp58065Order : text.fabric_weight_fit}</p><p>{isFeaturedHoodie ? t.pdp58065SpecNote : text.colourway_note}</p></div><table data-full-spec><caption>{t.pdpSpecs}</caption><tbody>{fullSpecs.map(([label,value]) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table></section>
{chart && <section class="wrap" id="size-chart"><h2>{t.sizeChart}</h2><p>{t.pdpMeasurements} · {t.pdpLengthUnit}{'weight_jin' in chart.rows && <> / {weightUnit}</>}{tolerance && <> · <bdi>{tolerance}</bdi> {t.pdpLengthUnit}</>}</p><div class="size-table-scroll" role="region" aria-label={t.sizeChart} tabindex="0"><table data-size-table><caption class="sr-only">{t.sizeChart}</caption><thead><tr><th scope="col">{t.pdpSize}</th>{Object.keys(chart.rows).map(key => <th scope="col" data-measurement={key}>{t[measurements[key]]}</th>)}</tr></thead><tbody>{visibleChartSizes(chart).map(({size,index}) => <tr><th scope="row"><bdi>{size}</bdi></th>{Object.entries(chart.rows).map(([key,values]) => <td data-measurement={key}>{key === 'weight_jin' && values[index] != null ? <><bdi>{chartWeight(String(values[index]), locale)}</bdi>{locale !== 'zh' && <> {weightUnit}</>}</> : <bdi>{values[index] ?? '—'}</bdi>}</td>)}</tr>)}</tbody></table></div><div class="size-swipe" aria-hidden="true"><p>{t.pdpSwipe}</p><span></span></div></section>}
<section class="wrap pdp-related"><h2>{t.pdpRelated}</h2><div class="product-grid">{relatedCards.map(product => <ProductCard product={product} />)}</div></section>
</Shell>


<style>
.pdp-related { padding-block: var(--sy-space-2xl) var(--sy-space-lg); width: min(100% - 2 * var(--sy-space-gutter-lg), calc(var(--sy-layout-desktop) - 2 * var(--sy-space-gutter-lg))); }
.pdp-related h2 { margin-block-end: var(--sy-space-2xl); }
@media (max-width: 1024px) { .pdp-related { padding-block-start: var(--sy-space-lg); } .pdp-related h2 { font-size: var(--sy-text-h2-mobile); line-height: 1.2; margin-block-end: var(--sy-space-md); } }
@media (max-width: 650px) { .pdp-related { width: calc(100% - 2 * var(--sy-space-gutter-mobile)); } }
  .pdp-section, .pdp-details, #size-chart { width: min(calc(100% - 2 * var(--sy-space-gutter-lg)), calc(var(--sy-layout-desktop) - 2 * var(--sy-space-gutter-lg))); }
  .pdp-section { padding-block: var(--sy-space-gutter-lg); }
  .pdp-breadcrumb, .product-info p { font-size: var(--sy-text-small); }
  .pdp-breadcrumb a { color: inherit; }
  .pdp { grid-template-columns: minmax(0, 760fr) minmax(0, 528fr); gap: var(--sy-space-split); margin-block-start: var(--sy-space-xl); }
  .product-info { display: flex; flex-direction: column; gap: var(--sy-space-lg); }
  .product-info h1 { font-size: var(--sy-text-h3); font-weight: var(--sy-weight-body); }
  .product-info p { line-height: 20px; }
  .pdp-details h2, #size-chart h2 { font-size: var(--sy-text-h4); font-weight: var(--sy-weight-body); }
  .product-info .actions { display: grid; margin: 0; }
  .product-info p, .product-info h1, .product-info h2, .product-info table { margin: var(--sy-space-0); }
  [data-full-spec] { table-layout: fixed; align-self: start; margin: 0; }
  .pdp-details-copy { display: grid; gap: var(--sy-space-lg); }
  .pdp-details-copy > * { margin: 0; }
  .pdp-details-copy h2 { line-height: 1.2; }
  .pdp-details-copy p { line-height: 22px; }
  [data-full-spec] th { width: 40%; }
  [data-full-spec] th, [data-full-spec] td { height: calc(var(--sy-space-2xl) + var(--sy-space-2xs)); padding-block: var(--sy-space-2xs); font-size: var(--sy-text-small); }
  [data-full-spec] caption { padding-block-end: var(--sy-space-sm); }
  .pdp-details { padding-block: var(--sy-space-section) var(--sy-space-2xl); border-block-start: var(--sy-space-hair) solid var(--sy-color-hairline); }
  #size-chart { padding-block: var(--sy-space-2xl); }
  @media (min-width: 769px) { #size-chart > h2 { margin-block-end: var(--sy-space-grid-y); } }
  #size-chart > p { margin-block: var(--sy-space-lg); font-size: var(--sy-text-small); }
  .size-table-scroll { overflow-x: auto; border: var(--sy-space-hair) solid var(--sy-color-hairline); border-radius: var(--sy-radius-inner); background: var(--sy-color-surface); }
  .size-table-scroll thead, .size-table-scroll th:first-child { background: var(--sy-color-surface-alt); }
  .size-table-scroll th, .size-table-scroll td { height: var(--sy-space-2xl); padding: var(--sy-space-xs) var(--sy-space-lg); text-align: center; font-size: var(--sy-text-small); font-weight: var(--sy-weight-body); }
  .size-swipe { display: none; }
  .size-table-scroll table { margin-block: 0; }
  @media (max-width: 768px) {
    .size-table-scroll { overflow-x: scroll; scrollbar-color: var(--sy-color-border) var(--sy-color-surface-alt); }
    .size-table-scroll table { min-width: max-content; }
    .size-table-scroll tr > :not(:first-child) { min-width: calc(var(--sy-space-section) + var(--sy-space-xl)); }
    .size-swipe { display: grid; gap: var(--sy-space-lg); margin-block-start: var(--sy-space-lg); }
    .size-swipe p { margin: 0; font-size: var(--sy-text-eyebrow); }
    .size-swipe span { height: var(--sy-space-2xs); border-radius: var(--sy-radius-pill); background: var(--sy-color-hairline); }
    .size-swipe span::before { display: block; content: ''; height: 100%; width: var(--chart-thumb-width, 40%); margin-inline-start: var(--chart-thumb-offset, 0%); border-radius: inherit; background: var(--sy-color-accent); }
    #size-chart { padding-block: var(--sy-space-gutter-mobile); }
    .size-table-scroll tr > :first-child { position: sticky; inset-inline-start: 0; background: var(--sy-color-surface-alt); }
  }
  .size-table-scroll th, .size-table-scroll td { white-space: nowrap; }
  .eyebrow { font-family: var(--sy-font-body); font-size: var(--sy-text-eyebrow); }
  @media (max-width: 1024px) { .pdp, .pdp-details { grid-template-columns: minmax(0, 1fr); gap: var(--sy-space-xl); } }
  @media (max-width: 768px) {
    .pdp-section { padding-block: var(--sy-space-gutter-mobile); }
    .pdp-details { gap: var(--sy-space-2xl); padding-block: calc(var(--sy-space-section-sm) + var(--sy-space-xs)) var(--sy-space-gutter-mobile); }
    .product-info h1 { font-size: var(--sy-text-h3-mobile); }
  }
  @media (max-width: 650px) {
    .pdp-section, .pdp-details, #size-chart { width: calc(100% - 2 * var(--sy-space-gutter-mobile)); }
  }
</style>

<script>
  const scroller = document.querySelector<HTMLElement>('.size-table-scroll');
  const swipe = document.querySelector<HTMLElement>('.size-swipe');
  if (scroller && swipe) {
    const update = () => {
      const width = scroller.scrollWidth;
      swipe.style.setProperty('--chart-thumb-width', `${100 * scroller.clientWidth / width}%`);
      swipe.style.setProperty('--chart-thumb-offset', `${100 * Math.abs(scroller.scrollLeft) / width}%`);
    };
    new ResizeObserver(update).observe(scroller);
    scroller.addEventListener('scroll', update, { passive: true });
  }
</script>
