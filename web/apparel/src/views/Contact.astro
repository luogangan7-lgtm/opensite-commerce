---
/** Contact uses the shared localized RFQ and quote-only FAQ. */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Shell from '../layouts/Shell.astro';
import RFQ from '../components/RFQ.astro';
import Illustration from '../components/Illustration.astro';
import { dictionaries, pageLocale } from '../i18n';
const locale = pageLocale(Astro.url), t = dictionaries[locale];
---
<Shell title={t.contact}><section class="wrap" data-rfq-success hidden tabindex="-1" role="status" aria-live="polite"><h1>{t.sent}</h1><p>{t.success}</p><a class="button" href={getRelativeLocaleUrl(locale, "/collections/")}>{t.backToProducts}</a></section><section class="wrap contact-heading"><h1>{t.contactTitle}</h1><p class="lead">{t.contactText}</p><div class="contact-banner"><Illustration id="contact/banner" sizes="100vw" /></div></section><section class="wrap split contact-form"><RFQ /><div><p>{t.terms}: {t.quote}.</p><h2>{t.factoryInfo}</h2><p>{t.factoryText}</p></div></section><section class="wrap"><h2>{t.faq}</h2><details><summary>{t.sampleQuestion}</summary><p>{t.sampleText} {t.sampleCost}: {t.quote}.</p></details><details><summary>{t.techQuestion}</summary><p>{t.briefText}</p></details><details><summary>{t.termsQuestion}</summary><p>{t.terms}: {t.quote}.</p></details></section></Shell>

<script>
  // The static Sent route uses the query at runtime; move focus after revealing it.
  if (new URLSearchParams(window.location.search).get('sent') === '1') {
    const confirmation = document.querySelector<HTMLElement>('[data-rfq-success]')!;
    confirmation.hidden = false;
    document.querySelector<HTMLElement>('.contact-heading')!.hidden = true;
    // Font loading can resize translated headers after focus's implicit scroll.
    void document.fonts.ready.then(() => {
      confirmation.focus({ preventScroll: true });
      confirmation.scrollIntoView({ block: 'start', behavior: 'instant' });
    });
  }
</script>
