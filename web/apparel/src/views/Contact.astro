---
/** Contact uses the shared localized RFQ and quote-only FAQ. */
import Shell from '../layouts/Shell.astro';
import RFQ from '../components/RFQ.astro';
import Illustration from '../components/Illustration.astro';
import { dictionaries, pageLocale } from '../i18n';
const t = dictionaries[pageLocale(Astro.url)];
---
<Shell title={t.contact}><section class="wrap contact-heading"><h1>{t.contactTitle}</h1><p class="lead">{t.contactText}</p><div class="contact-banner"><Illustration id="contact/banner" sizes="100vw" /></div></section><section class="wrap split contact-form"><RFQ /><div><p>{t.terms}: {t.quote}.</p><h2>{t.factoryInfo}</h2><p>{t.factoryText}</p></div></section><section class="wrap"><h2>{t.faq}</h2><details><summary>{t.sampleQuestion}</summary><p>{t.sampleText} {t.sampleCost}: {t.quote}.</p></details><details><summary>{t.techQuestion}</summary><p>{t.briefText}</p></details><details><summary>{t.termsQuestion}</summary><p>{t.terms}: {t.quote}.</p></details></section></Shell>
