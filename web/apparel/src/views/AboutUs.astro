---
/** Approved D-ABOUT2 brand story; shared Shell, HomeMedia, dictionaries and owner MOQ facts.
 * Called by the eight /about-us/ static routes. Factory stays at /about/.
 * Facts follow the approved Figma; images are decorative, SHA-bound existing artwork. */
import Shell from '../layouts/Shell.astro';
import HomeMedia from '../components/HomeMedia.astro';
import { dictionaries, pageLocale, type Key } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { aboutWays, aboutMoqCopy } from '../data/owner-facts';
const locale = pageLocale(Astro.url), t = dictionaries[locale];
const arrow = locale === 'ar' ? '←' : '→';
const b = (key: string) => t[`about.${key}` as Key];
const href = (route: string) => getRelativeLocaleUrl(locale, route);
const catalog = [['tees', 'apparel'], ['graphic', 'apparel'], ['hoodies', 'cotton430-hoodie'], ['sets', 'hoodie-set']];
---
<Shell title={t.shellAboutUs}>
<section class="about-section about-intro"><div class="about-inner">
  <p class="about-eyebrow">{b('intro-eyebrow')}</p><h1>{b('intro-title')}</h1><p class="about-lead">{b('intro-lead')}</p>
  <div class="about-intro-row"><div class="about-intro-image" data-about-intro-image><HomeMedia scope="about" id="factory-portrait" alt="" /></div><div class="about-copy">
    <h2 class="about-subtitle">{b('who-title')}</h2><p>{b('who-body')}</p><p>{b('who-options')}</p>
    <a class="button about-text-link" href={href('/collections/')}>{b('browse-wholesale')} <span aria-hidden="true">{arrow}</span></a>
  </div></div>
</div></section>
<section class="about-section"><div class="about-inner"><p class="about-eyebrow">{b('products-eyebrow')}</p><h2>{b('products-title')}</h2><p>{b('products-body')}</p>
  <div class="about-catalog">{catalog.map(([id, category]) => <a href={href(`/collections/${category}/`)}><HomeMedia scope="about" id={`about-${id}`} alt="" /><span>{b(`catalog-${id}`)}</span></a>)}</div>
</div></section>
<section class="about-section about-inverse"><div class="about-inner"><p class="about-eyebrow">{b('ways-eyebrow')}</p><h2>{b('ways-title')}</h2>
  <ol class="about-ways">{aboutWays.map(n => <li><span class="about-number">{b(`ways-num-${n}`)}</span><h3>{b(`ways-title-${n}`)}</h3><p data-owner-about-way={n}>{aboutMoqCopy(locale, n)}</p></li>)}</ol>
</div></section>
<section class="about-section"><div class="about-inner about-brand-row"><div class="about-copy"><p class="about-eyebrow">{b('brand-eyebrow')}</p><h2>{b('brand-title')}</h2><p>{b('brand-body')}</p><p class="about-capabilities">{b('brand-capabilities')}</p></div><div class="about-brand-images"><HomeMedia scope="about" id="factory-stitch" alt="" /><HomeMedia scope="about" id="factory-operator" alt="" /></div></div></section>
<section class="about-section"><div class="about-inner"><p class="about-eyebrow">{b('visit-eyebrow')}</p><h2 class="about-visit-title">{b('visit-title')}</h2><div class="about-visit-row"><figure class="about-visit-image"><HomeMedia scope="about" id="factory-floor" alt="" /><figcaption>{b('factory-caption')}</figcaption></figure><div class="about-copy"><h3 class="about-subtitle">{b('stall-title')}</h3><address>{b('stall-address')}</address><p>{b('stall-visit')}</p><p>{b('stall-role')}</p></div></div></div></section>
<section class="about-section about-sand"><div class="about-inner"><p class="about-eyebrow">{b('order-eyebrow')}</p><h2>{b('order-title')}</h2><div class="about-terms">{['quote','sample','ship'].map(k => <div class="about-copy"><h3>{b(`order-${k}-title`)}</h3><p>{b(`order-${k}-body`)}</p></div>)}</div></div></section>
<section class="about-section about-company"><div class="about-inner"><p class="about-eyebrow">{b('company-eyebrow')}</p><h2 class="about-subtitle">{b('company-title')}</h2><p>{b('company-brand')}</p><p>{b('company-entity')}</p></div></section>
<section class="about-section about-inverse"><div class="about-inner"><p class="about-eyebrow">{b('cta-eyebrow')}</p><h2>{b('cta-title')}</h2><p class="about-lead">{b('cta-body')}</p><a class="button about-quote" href={href('/contact/')}>{b('request-quote')} <span aria-hidden="true">{arrow}</span></a><p>{b('cta-contact')}</p></div></section>
</Shell>
<style>
 .about-section{padding:var(--sy-space-section);background:var(--sy-color-canvas);color:var(--sy-color-ink);line-height:1.55;border:var(--sy-space-0);}
 .about-inner{max-width:1248px;margin-inline:auto;display:flex;flex-direction:column;gap:var(--sy-space-gutter-lg);min-width:0;}
 .about-section h1,.about-section h2,.about-section h3,.about-section p,.about-section address{margin:0;max-width:none;}
 .about-section h1,.about-section h2,.about-section h3{line-height:1.15;}
 .about-section h1,.about-section h2{white-space:pre-line;text-wrap:balance;}
 .about-section h3{font-size:var(--sy-text-h4);}
 .about-section .about-subtitle{font-size:var(--sy-text-h3);white-space:pre-line;}
 .about-eyebrow{font-size:var(--sy-text-eyebrow);font-weight:var(--sy-weight-label);}
 .about-lead,.about-capabilities{font-size:var(--sy-text-lead);white-space:pre-line;}
 .about-intro>.about-inner>h1,.about-intro>.about-inner>.about-eyebrow,.about-intro>.about-inner>.about-lead{text-align:center;}
 .about-intro>.about-inner>.about-lead{max-width:850px;align-self:center;}
 .about-intro-row{display:grid;grid-template-columns:520px minmax(0,1fr);gap:var(--sy-space-gutter-lg);align-items:center;}
 .about-copy{display:flex;flex-direction:column;gap:var(--sy-space-grid-x);min-width:0;align-items:flex-start;}
 .about-copy>*{width:100%;}
 .about-intro-image{aspect-ratio:4/5;}
 .about-section :global(picture),.about-section :global(img){display:block;width:100%;height:100%;}
 .about-intro-image :global(img){object-fit:cover;object-position:50% 0%;}
 .about-text-link{align-self:flex-start;text-decoration:none;font-weight:var(--sy-weight-label);min-height:44px;display:flex;gap:var(--sy-space-xs);align-items:center;}
 .about-text-link:hover{text-decoration:underline;}
 .about-catalog{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--sy-space-grid-x);}
 .about-catalog a{min-width:0;text-decoration:none;display:grid;grid-template-rows:subgrid;grid-row:span 2;gap:var(--sy-space-md);}
 .about-catalog :global(picture){aspect-ratio:4/5;height:auto;}
 .about-catalog :global(img){object-fit:cover;}
 .about-ways{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--sy-space-grid-x);}
 .about-ways li{display:grid;grid-template-rows:subgrid;grid-row:span 3;gap:var(--sy-space-grid-x);min-width:0;}
 .about-number{font-family:var(--sy-font-heading);font-size:var(--sy-text-h4);}
 .about-inverse{background:var(--sy-color-surface-alt);color:var(--sy-color-ink);}
 .about-inverse h2,.about-inverse h3,.about-inverse p,.about-inverse a{color:inherit;}
 .about-brand-row,.about-visit-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sy-space-gutter-lg);align-items:start;}
 .about-brand-images{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sy-space-md);}
 .about-brand-images :global(img){object-fit:cover;aspect-ratio:1149/1369;}
 .about-visit-image{margin:0;}
 .about-visit-image :global(img){object-fit:cover;aspect-ratio:3/2;}
 .about-visit-image figcaption{font-size:var(--sy-text-small);margin-block-start:var(--sy-space-xs);}
 .about-visit-row .about-subtitle,.about-company p:last-child{font-family:var(--sy-font-body-zh);font-weight:var(--sy-weight-body);}
 .about-section address{font-style:normal;}
 .about-sand{background:var(--sy-color-surface-alt);}
 .about-terms{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--sy-space-gutter-lg);}
 .about-terms > div{display:grid;grid-template-rows:subgrid;grid-row:span 2;align-items:stretch;}
 .about-company p{white-space:pre-line;}
 .about-quote{align-self:flex-start;background:var(--sy-color-accent);color:var(--sy-color-on-accent)!important;}
 @media(min-width:1101px){
  .about-ways:lang(en) p{min-block-size:4lh;}
 }
 @media(max-width:1100px){
  .about-section{padding:var(--sy-space-section-sm) var(--sy-space-gutter-mobile);}
  .about-section h1{font-size:var(--sy-text-h1-mobile);}
  .about-section h2{font-size:var(--sy-text-h2-mobile);}
  .about-section .about-subtitle{font-size:var(--sy-text-h3-mobile);}
  .about-section h3{font-size:var(--sy-text-h4-mobile);}
  .about-number{font-size:var(--sy-text-h4-mobile);}
  .about-intro-row{grid-template-columns:300px minmax(0,1fr);gap:var(--sy-space-gutter-md);}
  .about-ways{grid-template-columns:repeat(2,minmax(0,1fr));}
  .about-brand-row{grid-template-columns:minmax(0,1fr) 300px;gap:var(--sy-space-gutter-md);align-items:center;}
  .about-visit-row{grid-template-columns:300px minmax(0,1fr);gap:var(--sy-space-gutter-md);align-items:center;}
  .about-terms{grid-template-columns:minmax(0,1fr);}
 }
 @media(max-width:900px){
  .about-intro h1{font-size:var(--sy-reading-title);}
  .about-section h2{font-size:var(--sy-text-h3-mobile);}
  .about-section .about-visit-title{font-size:var(--sy-reading-subtitle);}
  .about-intro-row,.about-brand-row,.about-visit-row{grid-template-columns:minmax(0,1fr);gap:var(--sy-space-gutter-lg);}
  .about-ways{grid-template-columns:minmax(0,1fr);}
  .about-number{line-height:1.15;}
  .about-ways li:first-child p:lang(en){min-block-size:3lh;}
  .about-terms p{min-block-size:4lh;}
  .about-terms p:lang(zh){min-block-size:3lh;}
  .about-ways:lang(ar) li:not(:nth-child(2)) p{min-block-size:4lh;}
  .about-catalog span:lang(ar){min-block-size:2lh;}
  .about-catalog{grid-template-columns:repeat(2,minmax(0,1fr));}
  .about-intro-image{block-size:calc((var(--sy-layout-mobile) - 2 * var(--sy-space-gutter-mobile)) * 1.25);max-block-size:125vw;}
  .about-brand-images{max-inline-size:calc(var(--sy-layout-mobile) - 2 * var(--sy-space-gutter-mobile));}
  .about-visit-image :global(img){block-size:calc((var(--sy-layout-mobile) - 2 * var(--sy-space-gutter-mobile)) * 2 / 3);max-block-size:66vw;}
 }
 @media(651px <= width <= 900px){
  .about-section{padding-inline:var(--sy-space-gutter-lg);}
  .about-terms > div:last-child p{min-block-size:2lh;}
 }
 @media(max-width:650px){
  .about-catalog{row-gap:var(--sy-space-0);}
 }
</style>
