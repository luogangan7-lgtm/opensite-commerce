---
/** Locale recovery template; static routes and native Pages 404.html share these exact bytes. */
import Shell from '../layouts/Shell.astro';
import { pageLocale } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import copy from '../content/legal-ui.json';
const locale = pageLocale(Astro.url), t = copy[locale];
const destinations = ['collections/', 'products/cotton430-hoodie-58065/', 'oem-odm/', 'contact/'];
const arrow = locale === 'ar' ? '←' : '→';
const labels = [t.collections, t.details, t.oem, t.quote];
---
<Shell title={t.title}>
  <section class="recovery" data-not-found>
    <p class="error-code" aria-hidden="true">404</p><h1>{t.title}</h1><p>{t.intro}</p>
    <div class="recovery-grid">{destinations.map((path, i) => <a class="recovery-card" data-recovery-card href={getRelativeLocaleUrl(locale, path)}><span>{labels[i]} <span aria-hidden="true">{arrow}</span></span><p>{t.descriptions[i]}</p></a>)}</div>
    <a class="button" href={getRelativeLocaleUrl(locale, '/')}>{t.home}</a>
  </section>
</Shell>
<style>
  .recovery { display: grid; justify-items: center; gap: var(--sy-space-lg); padding: var(--sy-space-section-sm) var(--sy-space-gutter-lg); text-align: center; border: 0; }
  .recovery > * { margin: 0; }
  .error-code { font: var(--sy-weight-heading) 88px/1.2 var(--sy-font-heading); }
  .recovery h1 { font-weight: var(--sy-weight-body); font-size: var(--sy-text-h3); }
  .recovery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sy-space-lg); width: min(100%, 768px); }
  .recovery-card { display: grid; grid-template-rows: subgrid; grid-row: span 2; gap: var(--sy-space-sm); padding-block: var(--sy-space-xs); text-align: start; text-decoration: none; }
  .recovery-card > span { display: flex; justify-content: space-between; align-items: center; gap: var(--sy-space-sm); border-block-end: var(--sy-space-hair) solid var(--sy-color-hairline); }
  .recovery-card:hover > span { text-decoration: underline; }
  .recovery-card p { margin: 0; }

  @media (max-width: 650px) {
    .recovery { padding-block: var(--sy-space-lg); padding-inline: var(--sy-space-gutter-mobile); }
    .recovery-grid { grid-template-columns: minmax(0, 1fr); }
    .recovery .button { width: 100%; }
  }
</style>
