---
/** Foundation routes reuse existing RFQ and copy; legal content awaits owner approval. */
import Shell from '../layouts/Shell.astro';
import RFQ from '../components/RFQ.astro';
import { dictionaries, pageLocale } from '../i18n';
const { kind } = Astro.props;
const t = dictionaries[pageLocale(Astro.url)];
const titles: Record<string, string> = { 'oem-odm': 'OEM / ODM', sampling: t.samples, shipping: 'Shipping', privacy: 'Privacy', terms: 'Terms' };
const text = kind === 'oem-odm' ? t.oemText : kind === 'sampling' ? t.sampleText : t.confirmText;
---
<Shell title={titles[kind]}><section class="wrap"><h1>{titles[kind]}</h1><p class="lead">{text}</p><div id={kind === 'privacy' ? 'cookies' : undefined}></div><RFQ /></section></Shell>
