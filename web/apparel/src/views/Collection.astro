---
/** Category template: localized navigation and the common URL facet/grid composition. */
import Shell from '../layouts/Shell.astro';
import CollectionResults from '../components/CollectionResults.astro';
import { products, categories } from '../data/catalog';
import { dictionaries, pageLocale, type Key } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
interface Props { category: string }
const {category}=Astro.props,locale=pageLocale(Astro.url),t=dictionaries[locale];
---
<Shell title={t[category as Key]}><section class="wrap page-intro"><a href={getRelativeLocaleUrl(locale,'/collections/')}>{t.allCollections}</a><h1>{t[category as Key]}</h1><p class="lead">{t.categoryLead}</p><nav class="category-links" aria-label={t.collections}>{Object.keys(categories).map(key=><a href={getRelativeLocaleUrl(locale,`/collections/${key}/`)} aria-current={key===category?'page':undefined}>{t[key as Key]} ({products.filter(p=>p.category===key).length})</a>)}</nav><CollectionResults products={products.filter(p=>p.category===category)}/></section></Shell>
