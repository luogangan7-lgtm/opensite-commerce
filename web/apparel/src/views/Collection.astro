---
/** Existing category URLs retain their static catalog scope and share the store listing. */
import Shell from '../layouts/Shell.astro';
import ShopListing from '../components/ShopListing.astro';
import { dictionaries, pageLocale, type Key } from '../i18n';
interface Props { category: string }
const {category}=Astro.props,t=dictionaries[pageLocale(Astro.url)];
---
<Shell title={t[category as Key]}><ShopListing category={category}/></Shell>
