---
/** PDP gallery owns role selection, colour context and native swipe; Product supplies catalog facts.
 * Never reuse another colour's photograph when a view is unavailable. */
import ViewToggle from './ViewToggle.astro';
import type { Product } from '../data/catalog';
import { orderedGallery, primaryColour, galleryColours, isDetail } from '../data/gallery';
import { pageLocale, dictionaries, productText } from '../i18n';
import { digitalAlt } from '../data/imagery';
interface Props { product: Product }
const {product} = Astro.props;
const locale = pageLocale(Astro.url), t = dictionaries[locale], text = productText[locale][product.slug];
const primary = primaryColour(product.images), colours = galleryColours(product.images);
const labels: Record<string,string> = {front:t.galleryFront,back:t.galleryBack,turn:t.gallerySide,structure:t.galleryConstruction,fabric:t.galleryFabric};
const images = orderedGallery(product.images);
const initial = images[0];
const colourLabel = (image: typeof initial) => {
 const colour = digitalAlt(image.src,locale)?.split(';')[0] || image.colour || '';
 return `${t.galleryColour} / ${locale==='en'?colour.charAt(0).toUpperCase()+colour.slice(1):colour}`;
};
const alt = (image: typeof initial) => digitalAlt(image.src,locale) || `${text.name}: ${t.view} ${images.indexOf(image) + 1}`;
---
<div class="gallery" data-fb-gallery>
 <ViewToggle label={t.productViews} labels={{pair:t.galleryPair,side:t.gallerySide,details:t.galleryDetails}} controls="gallery-panel" />
 <div class="gallery-layout">
  <div class="grouped-rail">
   {colours.map(colour=><nav class="gallery-thumbs" data-gallery-colour={colour.colour} hidden={colour.colour!==primary} aria-label={t.productViews}>
    {orderedGallery(product.images,colour.colour,primary).map((image,index)=><a href={image.src} data-role={image.role} data-colour={image.colour} data-fit={isDetail(image)?'contain':undefined} aria-label={alt(image)} aria-current={index===0?'true':undefined}><img src={image.src} alt={alt(image)} width="64" height="80" loading="lazy"/><span>{image.role==='structure'?t.galleryDetails:labels[image.role!]||t.galleryDetails}</span></a>)}
   </nav>)}
  </div>
  <div id="gallery-panel" role="tabpanel" aria-labelledby="view-pair" tabindex="0" class="gallery-slides" data-gallery-slides aria-roledescription="carousel">
   <figure data-gallery-slide="front"><picture class="image-card"><source data-gallery-mobile media="(max-width: 767px)" srcset={initial.src.replace(/\.webp$/, '-640.webp')} /><img data-gallery-main data-pdp-whole src={initial.src} alt={alt(initial)} width="800" height="1000" loading="eager" decoding="async" fetchpriority="high" role="button" tabindex="0" aria-haspopup="dialog" /></picture><figcaption data-gallery-label>{t.galleryFront}</figcaption></figure>
   <figure data-gallery-slide="back"><picture class="image-card"><source data-gallery-back-mobile media="(max-width: 767px)" srcset={images.find(i=>i.role==='back')?.src.replace(/\.webp$/, '-640.webp')} /><img data-gallery-back src={images.find(i=>i.role==='back')?.src} alt={t.galleryBack} width="800" height="1000" loading="eager" decoding="async" role="button" tabindex="0" aria-haspopup="dialog" /></picture><figcaption>{t.galleryBack}</figcaption><p data-view-unavailable hidden>{t.galleryUnavailable}</p></figure><p data-primary-unavailable hidden>{t.galleryUnavailable}</p>
  </div>
 </div>
 <nav class="gallery-colours" aria-label={t.productViews}>{colours.map(image=><button type="button" data-gallery-swatch={image.colour} data-gallery-colour-label={colourLabel(image)} aria-pressed={image.colour===primary?'true':'false'} aria-label={digitalAlt(image.src,locale)||image.colour}><img src={image.src} alt={digitalAlt(image.src,locale)||image.colour} width="64" height="80" loading="lazy"/></button>)}</nav>
 <p class="gallery-colour-label" data-gallery-colour-label>{colourLabel(initial)}</p>
 <div class="gallery-tiles" data-pdp-media>{['turn','structure','fabric'].map(role=>{const image=images.find(i=>i.role===role);return <figure data-gallery-tile={role} hidden={!image}><div class="gallery-tile-photo"><img data-pdp-detail={role === 'structure' ? true : undefined} data-pdp-fabric={role === 'fabric' ? true : undefined} src={image?.src} alt={image?alt(image):labels[role]} width="800" height="800" loading="lazy" decoding="async"/></div><figcaption>{labels[role]}</figcaption></figure>})}</div>
 <p class="sr-only" aria-live="polite" data-gallery-status></p>
 <dialog data-gallery-viewer aria-label={alt(initial)}><form method="dialog"><button aria-label={t.galleryClose}>×</button></form><p data-viewer-title>{alt(initial)}</p><img src={initial.src} alt={alt(initial)} width="1200" height="1200" /></dialog>
</div>
<script>
 const root = document.querySelector<HTMLElement>('[data-fb-gallery]');
 if(root) {
 const main=root.querySelector<HTMLImageElement>('[data-gallery-main]')!, back=root.querySelector<HTMLImageElement>('[data-gallery-back]')!;
 const slides=root.querySelector<HTMLElement>('[data-gallery-slides]')!, second=root.querySelector<HTMLElement>('[data-gallery-slide=back]')!;
 const viewer=root.querySelector<HTMLDialogElement>('dialog')!;
 const tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-gallery-view]')];
 let view='pair';
 const links=()=>[...root.querySelectorAll<HTMLAnchorElement>('.gallery-thumbs:not([hidden]) a')];
 const choose=(link:HTMLAnchorElement)=>{
  const mobile=root.querySelector('source[data-gallery-mobile]')!;if(link.dataset.fit==='contain')mobile.removeAttribute('srcset');else mobile.setAttribute('srcset',link.getAttribute('href')!.replace(/\.webp$/,'-640.webp'));
  main.src=link.getAttribute('href')!; main.alt=link.querySelector('img')!.alt; main.dataset.fit=link.dataset.fit||'';
  root.querySelector('[data-gallery-label]')!.textContent=link.querySelector('span')!.textContent;
  root.querySelectorAll('.gallery-thumbs a').forEach(n=>n.removeAttribute('aria-current'));link.setAttribute('aria-current','true');
 };
 const select=(next:string)=>{
  view=next; tabs.forEach(tab=>{const active=tab.dataset.galleryView===view;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1});
  slides.setAttribute('aria-labelledby',`view-${view}`);second.hidden=view!=='pair';
  const role=view==='side'?'turn':view==='details'?'structure':'front';
  const link=links().find(n=>n.dataset.role===role)||(view==='details'?links().find(n=>n.dataset.role==='fabric'):undefined);
  main.closest('figure')!.hidden=!link;
  if(link) choose(link);else main.removeAttribute('src');
  root.querySelector<HTMLElement>('[data-primary-unavailable]')!.hidden=!!link;
  root.querySelector('[data-gallery-status]')!.textContent=link?link.querySelector('img')!.alt:root.querySelector('[data-view-unavailable]')!.textContent;
  slides.scrollTo({left:0});
 };
 tabs.forEach((tab,index)=>{
  tab.addEventListener('click',()=>select(tab.dataset.galleryView!));
  tab.addEventListener('keydown',event=>{
   const rtl=getComputedStyle(root).direction==='rtl';
   let target=index;
   if(event.key==='ArrowRight')target=(index+(rtl?-1:1)+tabs.length)%tabs.length;
   else if(event.key==='ArrowLeft')target=(index+(rtl?1:-1)+tabs.length)%tabs.length;
   else if(event.key==='Home')target=0;else if(event.key==='End')target=tabs.length-1;else return;
   event.preventDefault();tabs[target].focus();select(tabs[target].dataset.galleryView!);
  });
 });
 const sync=()=>{
  const all=links(), b=all.find(n=>n.dataset.role==='back');
  root.querySelector('[data-gallery-colour-label]:not(button)')!.textContent=root.querySelector<HTMLElement>('[data-gallery-swatch][aria-pressed=true]')!.dataset.galleryColourLabel!;
  back.hidden=!b;back.closest('picture')!.hidden=!b;second.querySelector<HTMLElement>('[data-view-unavailable]')!.hidden=!!b;
  const backMobile=root.querySelector('source[data-gallery-back-mobile]')!;if(b)backMobile.setAttribute('srcset',b.getAttribute('href')!.replace(/\.webp$/,'-640.webp'));else backMobile.removeAttribute('srcset');
  if(b){back.src=b.getAttribute('href')!;back.alt=b.querySelector('img')!.alt}else{back.removeAttribute('src')}
  root.querySelectorAll<HTMLElement>('[data-gallery-tile]').forEach(tile=>{const link=all.find(n=>n.dataset.role===tile.dataset.galleryTile);tile.hidden=!link;const img=tile.querySelector('img')!;if(link){img.src=link.getAttribute('href')!;img.alt=link.querySelector('img')!.alt}else img.removeAttribute('src')});
  select(view);
 };
 root.querySelectorAll<HTMLAnchorElement>('.gallery-thumbs a').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();const role=link.dataset.role;select(role==='front'||role==='back'?'pair':role==='turn'?'side':'details');if(role==='back'){if(matchMedia('(max-width:767px)').matches)move(1)}else choose(link)}));
 root.querySelectorAll<HTMLButtonElement>('[data-gallery-swatch]').forEach(swatch=>swatch.addEventListener('click',()=>{
  viewer.close();root.querySelectorAll<HTMLButtonElement>('[data-gallery-swatch]').forEach(n=>n.setAttribute('aria-pressed',String(n===swatch)));
  root.querySelectorAll<HTMLElement>('[data-gallery-colour]').forEach(n=>n.hidden=n.dataset.galleryColour!==swatch.dataset.gallerySwatch);
  document.querySelectorAll<HTMLAnchorElement>('[data-rfq-intent]').forEach(link=>{const url=new URL(link.href);url.searchParams.set('colour',swatch.dataset.gallerySwatch!);link.href=url.href});view='pair';sync();
 }));
 const open=(img:HTMLImageElement)=>{if(!img.getAttribute('src'))return;const target=viewer.querySelector('img')!;target.src=img.src;target.alt=img.alt;viewer.setAttribute('aria-label',img.alt);viewer.querySelector('[data-viewer-title]')!.textContent=img.alt;viewer.showModal()};
 main.addEventListener('click',()=>open(main));back.addEventListener('click',()=>open(back));
 for(const image of [main,back])image.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open(image)}});
 const move=(direction:number)=>slides.scrollBy({left:direction*slides.clientWidth*(getComputedStyle(root).direction==='rtl'?-1:1),behavior:'smooth'});
 slides.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();move(e.key==='ArrowRight'?1:-1)}});
 sync();
 }
</script>
<style>
 .gallery{min-width:0;display:flex;flex-direction:column;gap:var(--sy-space-md);align-self:start}
 .gallery-layout{display:grid;grid-template-columns:64px minmax(0,1fr);gap:var(--sy-space-md);align-items:start}
 .gallery-thumbs{display:flex;flex-direction:column;gap:var(--sy-space-sm);max-height:443px;overflow:auto;margin:0;padding:0}
 .gallery-thumbs[hidden], [hidden]{display:none!important}
 .gallery-thumbs a{display:flex;flex-direction:column;align-items:start;gap:var(--sy-space-2xs);flex:none;border-radius:var(--sy-radius-inner);text-decoration:none;background:transparent;overflow:visible}
 .gallery-thumbs a[aria-current]{outline:none}
 .gallery-thumbs a[aria-current] img{outline:2px solid var(--sy-color-accent);outline-offset:2px}
 .gallery-thumbs img{width:48px;height:60px;object-fit:cover;object-position:center top;border-radius:var(--sy-radius-inner)}
 .gallery-thumbs span{display:block;font-size:var(--sy-text-eyebrow)}
 .gallery-slides{min-width:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sy-space-md)}
 .gallery-slides figure{min-width:0;margin:0}
 .image-card{display:block;border-radius:var(--sy-radius-image);overflow:hidden;background:var(--sy-color-surface);box-shadow:var(--sy-shadow-card)}
 .image-card img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:contain;object-position:50% 0;border-radius:var(--sy-radius-image);cursor:zoom-in}
 .image-card img[data-fit=contain]{object-fit:contain}
 figcaption{padding-block-start:var(--sy-space-xs);font-size:var(--sy-text-eyebrow)}
 .gallery-colours{display:flex;gap:var(--sy-space-xs);flex-wrap:wrap}
 .gallery-colours button{width:44px;height:55px;min-width:44px;min-height:44px;padding:0;border:0;border-radius:var(--sy-radius-inner);background:transparent;flex:none}
 .gallery-colours button[aria-pressed=true]{outline:2px solid var(--sy-color-accent);outline-offset:2px}
 .gallery-colour-label{margin:0;font-size:var(--sy-text-eyebrow)}
 .gallery-colours img{display:block;width:44px;height:55px;object-fit:contain;object-position:top;border-radius:var(--sy-radius-inner)}
 .gallery-tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--sy-space-sm)}
 .gallery-tiles figure{margin:0;min-width:0}
 .gallery-tile-photo{position:relative;aspect-ratio:1;}
 .gallery-tiles img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:top;border-radius:var(--sy-radius-image)}
 @media(min-width:1101px){.gallery{position:sticky;top:var(--sy-space-lg)}}
 @media(max-width:767px){.gallery-layout{display:flex;flex-direction:column-reverse}.grouped-rail{display:none}.gallery-slides{display:flex;width:100%;gap:var(--sy-space-sm);overflow-x:auto;scroll-snap-type:x mandatory}.gallery-slides figure{flex:0 0 calc(100% - 24px);scroll-snap-align:start}}
 @media(prefers-reduced-motion:reduce){.gallery-slides{scroll-behavior:auto}}
</style>
