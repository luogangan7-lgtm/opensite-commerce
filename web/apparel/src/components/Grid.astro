---
/** Shared image-first grid; static catalog allow-list and committed product translations. */
import EnglishFallback from './EnglishFallback.astro';
import type { Product } from '../data/catalog';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { pageLocale, productText } from '../i18n';
interface Props { products: Product[] }
const locale = pageLocale(Astro.url);
---
{locale === 'zh' && <EnglishFallback />}
<div class="product-grid">{Astro.props.products.map(product => <a class="tile" href={getRelativeLocaleUrl(locale, `/products/${product.slug}/`)}><img lang={locale === 'zh' ? 'en' : undefined} src={product.images[0].src} alt={productText[locale][product.slug].name} width="600" height="720" loading="lazy" decoding="async" /><p class="muted"><bdi>{product.style_codes.join(' / ')}</bdi></p><h3 lang={locale === 'zh' ? 'en' : undefined}>{productText[locale][product.slug].name}</h3></a>)}</div>
