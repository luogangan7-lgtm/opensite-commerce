---
/** Shared localized consent UI; normal flow keeps RFQ controls unobstructed. */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { dictionaries, pageLocale } from '../i18n';
const locale = pageLocale(Astro.url), t = dictionaries[locale];
---
<aside class="cookie-banner" data-cookie-banner hidden aria-labelledby="cookie-title">
  <div><h2 id="cookie-title">{t.cookieTitle}</h2><p>{t.cookieText}</p></div>
  <div class="cookie-actions"><button type="button" data-cookie-choice="essential">{t.cookieEssential}</button><button type="button" data-cookie-choice="all">{t.cookieAccept}</button><a href={getRelativeLocaleUrl(locale, '/privacy/') + '#cookies'}>{t.cookieSettings}</a></div>
</aside>
<style>
  .cookie-banner { padding: 1.5rem; background: var(--color-surface, #f4f2ee); border-block: 1px solid currentColor; text-align: start; }
  .cookie-banner:not([hidden]) { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .cookie-banner h2 { font-size: 1.2rem; margin: 0; }
  .cookie-banner p { margin-block: .5rem 0; max-width: 65ch; }
  .cookie-actions { display: flex; gap: .75rem; flex-wrap: wrap; flex-shrink: 0; }
  .cookie-actions button, .cookie-actions a { min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; justify-content: center; }
  @media (max-width: 900px) { .cookie-banner:not([hidden]) { flex-direction: column; align-items: stretch; } .cookie-actions { flex-direction: column; } }
</style>
<script>
  const key = 'sourcyo-cookie-consent-v1';
  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]')!;
  let choice: string | null = null;
  try { choice = localStorage.getItem(key); } catch { /* Still allow an in-page choice. */ }
  banner.hidden = choice === 'all' || choice === 'essential';
  const open = () => { banner.hidden = false; banner.scrollIntoView({ block: 'center' }); banner.querySelector<HTMLButtonElement>('button')!.focus(); };
  banner.querySelectorAll<HTMLButtonElement>('[data-cookie-choice]').forEach(button => button.addEventListener('click', () => {
    const value = button.dataset.cookieChoice!;
    try { localStorage.setItem(key, value); } catch { /* Consent applies only to this page. */ }
    window.dispatchEvent(new CustomEvent('apparel:consent', { detail: value }));
    banner.hidden = true;
    document.querySelector<HTMLElement>('[data-cookie-reopen], main h1')?.focus({ preventScroll: true });
  }));
  document.querySelectorAll('[data-cookie-reopen]').forEach(button => button.addEventListener('click', open));
  const hash = () => { if (/\/privacy\/?$/.test(location.pathname) && location.hash === '#cookies') open(); };
  window.addEventListener('hashchange', hash);
  window.addEventListener('storage', event => { if (event.key === key || event.key === null) banner.hidden = event.newValue === 'all' || event.newValue === 'essential'; });
  hash();
</script>
