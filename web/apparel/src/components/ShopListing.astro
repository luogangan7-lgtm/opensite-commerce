---
/** Store listing owns facets, URL state, pagination and accessible front/back controls.
 * Depends on static catalog and owner MOQ facts; no client requests or inferred facts.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { products, categories } from '../data/catalog';
import { shopFacts, shopFacets, cardViews } from '../data/shop';
import { ownerMoq, pdpMoq } from '../data/owner-facts';
import { digitalAlt, digitalLabel } from '../data/imagery';
import { dictionaries, pageLocale, productText, type Key } from '../i18n';
interface Props { category?: string }
const { category } = Astro.props;
const locale = pageLocale(Astro.url), t = dictionaries[locale];
const items = category ? products.filter(p => p.category === category) : products;
const choices: Record<string,string[]> = Object.fromEntries(shopFacets.map(key => [key, [...new Set(items.flatMap(p => shopFacts(p)[key]))].sort()]));
const label = (key: string) => t[`cp-shop/${key}` as Key];
---
<div class="shop" data-shop data-products={JSON.stringify(items)} data-count-template={label('count')}>
 <div class="shop-title"><p>{t.collections}</p><h1>{category ? t[category as Key] : label('all')}</h1><p>{t.collectionLead}</p></div>
 <nav class="shop-tabs" aria-label={t.collections}>
  <a href={getRelativeLocaleUrl(locale, '/collections/')} aria-current={!category ? 'page' : undefined}>{label('all')}</a>
  {Object.keys(categories).map(key => <a href={getRelativeLocaleUrl(locale, `/collections/${key}/`)} aria-current={category === key ? 'page' : undefined}>{t[key as Key]}</a>)}
 </nav>
 <div class="shop-layout">
 <button type="button" class="shop-filter-open" data-shop-filter-open hidden>{label('filters')}</button><dialog class="shop-filter-dialog" data-shop-filter-dialog><form method="dialog"><button aria-label={t.menuClose}>×</button></form></dialog><details class="shop-filters" open><summary>{label('filters')}</summary>
 <div class="shop-facet-list">{shopFacets.map(key => <label>{label(key)}<select data-shop-facet={key} aria-label={label(key)}><option value="">{label('any')}</option>{choices[key].map((v: string) => <option value={v}>{key === 'category' ? t[v as Key] : key === 'fleece' ? (v === 'yes' ? t['cp6.chip-fleece'] : t['cp6.filter-unlined']) : v}</option>)}</select></label>)}
 <button type="button" data-shop-clear>{t['cp6.copy/clear-filters']}</button></div>
 </details>
 <div class="shop-results">
 <div class="shop-toolbar"><p data-shop-count role="status" aria-live="polite">{label('count').replace('{shown}',String(items.length)).replace('{total}',String(items.length))}</p><label>{label('sort')}<select data-shop-sort><option value="featured">{label('featured')}</option><option value="code">{label('code')}</option></select></label></div>
 <p class="shop-disclosure">{digitalLabel(locale)}</p>
 <div class="shop-grid">{items.map(p => {
 const { front, back } = cardViews(p), name = productText[locale][p.slug].name;
 const colours = p.images.filter(i => i.role === 'front' && i.colour);
 const url = getRelativeLocaleUrl(locale, `/products/${p.slug}/`);
 const quote = `${getRelativeLocaleUrl(locale, '/contact/')}?${new URLSearchParams({ product: p.slug, colour: front.colour || '' })}#rfq-form`;
 return <article class="shop-card" data-shop-card={p.slug}>
  <div class="shop-photo" data-swapped="false"><a href={url} aria-label={name}><img src={front.src} alt={digitalAlt(front.src,locale) || name} width="600" height="750" loading="lazy" decoding="async" />{back && <img class="shop-back" data-role="back" src={back.src} alt={digitalAlt(back.src,locale) || name} width="600" height="750" loading="lazy" decoding="async" />}</a>{back && <button type="button" data-shop-swap aria-pressed="false" aria-label={`${label('swap')} · ${p.style_codes.join(' / ')}`}>{label('swap')}</button>}</div>
  <p><bdi>{p.style_codes.join(' / ')}</bdi></p><h2><a href={url}>{name}</a></h2>
  <p class="shop-colours" aria-label={p.colourway_note}>{colours.slice(0,4).map(i => <img src={i.src} alt={digitalAlt(i.src,locale) || i.colour} width="16" height="16" loading="lazy" />)}<span>({colours.length})</span></p>
  <p class="shop-moq">{pdpMoq[locale]}</p><a class="shop-quote" href={quote}>{t.request}</a>
 </article>;
 })}</div>
 <div data-shop-empty hidden><h2>{t['cp6.copy/no-styles-match-these-filters']}</h2><p>{t['cp6.copy/try-removing-a-filter-or-request-a-style-tha']}</p></div>
 <button type="button" data-shop-more hidden>{label('more')}</button>
 </div></div>
 <aside class="shop-b2b"><p>{pdpMoq[locale]}</p><p>{label('custom').replace('{moq}', ownerMoq.custom.toLocaleString(locale))}</p><a href={getRelativeLocaleUrl(locale,'/sampling/')}>{t.samples}</a><a href={getRelativeLocaleUrl(locale,'/shipping/')}>{t['about.order-ship-title']}</a></aside>
</div>
<script>
import { pageSize, selectStyles, setShopQuery, shopFacets, type ShopFacet } from '../data/shop';
import type { Product } from '../data/catalog';
for (const root of document.querySelectorAll<HTMLElement>('[data-shop]')) {
 const items: Product[] = JSON.parse(root.dataset.products!);
 const grid = root.querySelector<HTMLElement>('.shop-grid')!;
 const tiles = new Map([...root.querySelectorAll<HTMLElement>('[data-shop-card]')].map(el => [el.dataset.shopCard!, el]));
 const more = root.querySelector<HTMLButtonElement>('[data-shop-more]')!;
 const facets = [...root.querySelectorAll<HTMLSelectElement>('[data-shop-facet]')];
 const filterOpen = root.querySelector<HTMLButtonElement>('[data-shop-filter-open]')!;
 const dialog = root.querySelector<HTMLDialogElement>('[data-shop-filter-dialog]')!;
 const filters = root.querySelector<HTMLDetailsElement>('.shop-filters')!;
 const anchor = document.createComment('filters'); filters.before(anchor);
 filterOpen.hidden = false; root.dataset.enhanced = 'true';
 filterOpen.addEventListener('click', () => { dialog.append(filters); filters.open = true; dialog.showModal(); });
 dialog.addEventListener('close', () => { anchor.after(filters); filterOpen.focus(); });
 const sort = root.querySelector<HTMLSelectElement>('[data-shop-sort]')!;
 let limit = pageSize;
 function render() {
  const q = new URLSearchParams(location.search), selected = selectStyles(items,q);
  for (const el of tiles.values()) el.hidden = true;
  selected.forEach((p,index) => { const el = tiles.get(p.slug)!; grid.append(el); el.hidden = index >= limit; });
  for (const el of facets) el.value = q.get(el.dataset.shopFacet!) || '';
  sort.value = q.get('sort') === 'code' ? 'code' : 'featured';
  root.querySelector<HTMLElement>('[data-shop-count]')!.textContent = root.dataset.countTemplate!.replace('{shown}',String(Math.min(limit,selected.length))).replace('{total}',String(selected.length));
  root.querySelector<HTMLElement>('[data-shop-empty]')!.hidden = selected.length !== 0;
  more.hidden = selected.length <= limit;
 }
 function update(key: ShopFacet | 'sort', value: string) {
  const url = new URL(location.href); url.search = setShopQuery(url.searchParams,key,value).toString();
  history.pushState(null,'',url); limit = pageSize; render();
 }
 for (const el of facets) el.addEventListener('change', () => update(el.dataset.shopFacet as ShopFacet,el.value));
 sort.addEventListener('change', () => update('sort',sort.value));
 more.addEventListener('click', () => { limit += pageSize; render(); });
 root.querySelector('[data-shop-clear]')!.addEventListener('click', () => {
  const url = new URL(location.href); for (const key of [...shopFacets,'sort']) url.searchParams.delete(key);
  history.pushState(null,'',url); limit = pageSize; render();
 });
 for (const button of root.querySelectorAll<HTMLButtonElement>('[data-shop-swap]')) button.addEventListener('click', () => {
  const next = button.getAttribute('aria-pressed') !== 'true'; button.setAttribute('aria-pressed',String(next)); button.parentElement!.dataset.swapped = String(next);
 });
 addEventListener('popstate', () => { limit = pageSize; render(); }); render();
}
</script>
<style>
.shop{width:min(calc(100% - 2 * var(--sy-space-gutter-lg)),calc(var(--sy-layout-desktop) - 2 * var(--sy-space-gutter-lg)));margin-inline:auto;padding-block:var(--sy-space-section-sm);color:var(--sy-color-ink)}
.shop-title{margin-block-end:var(--sy-space-xl)}
.shop-title h1{font-size:var(--sy-text-h2);margin-block:var(--sy-space-sm)}
.shop-tabs{display:flex;gap:var(--sy-space-md);overflow-x:auto;margin-block-end:var(--sy-space-xl);border-block-end:var(--sy-space-hair) solid var(--sy-color-hairline)}
.shop-tabs a{white-space:nowrap;padding:var(--sy-space-sm) var(--sy-space-md);text-decoration:none}
.shop-tabs [aria-current]{box-shadow:inset 0 calc(-1 * var(--sy-space-hair)) var(--sy-color-ink)}
.shop-layout{display:grid;grid-template-columns:calc(7 * var(--sy-space-xl)) minmax(0,1fr);gap:var(--sy-space-grid-x)}
.shop-filter-open{display:none!important}.shop-filter-dialog{width:min(calc(100% - 2 * var(--sy-space-gutter-mobile)),var(--sy-layout-mobile));max-height:90dvh;padding:var(--sy-space-lg);border:var(--sy-space-hair) solid var(--sy-color-border);border-radius:var(--sy-radius-card);background:var(--sy-color-surface);color:var(--sy-color-ink)}.shop-filter-dialog::backdrop{background:var(--sy-color-overlay)}.shop-filter-dialog .shop-filters{display:block}.shop-filters{align-self:start;border:0;padding:0}
.shop-filters summary{min-height:var(--control-size-md);cursor:pointer}
.shop-facet-list{display:grid;gap:var(--sy-space-lg)}
.shop-facet-list label,.shop-toolbar label{display:grid;gap:var(--sy-space-xs)}
.shop select{width:100%;min-height:var(--control-size-md);padding:var(--sy-space-xs);border:var(--sy-space-hair) solid var(--sy-color-border);border-radius:var(--sy-radius-control);color:var(--sy-color-ink);background:var(--sy-color-surface);font:inherit}
.shop button{border-width:var(--sy-space-hair);border-radius:var(--sy-radius-control);background:var(--sy-color-surface);border-color:var(--sy-color-border);color:var(--sy-color-ink);padding:var(--sy-space-sm) var(--sy-space-md);min-height:var(--control-size-md)}
.shop button:hover{background:var(--sy-color-placeholder)}
.shop-toolbar{display:flex;align-items:center;justify-content:space-between;gap:var(--sy-space-md);margin-block-end:var(--sy-space-md)}
.shop-toolbar label{display:flex;align-items:center}
.shop-disclosure{font-size:var(--sy-text-small);color:var(--sy-color-muted)}
.shop-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--sy-space-grid-y) var(--sy-space-grid-x)}
.shop-card{min-width:0}
.shop-card[hidden]{display:none}
.shop-photo{position:relative;aspect-ratio:4/5;border-radius:var(--sy-radius-card);overflow:hidden;background:var(--sy-color-placeholder)}
.shop-photo a{display:block;height:100%}
.shop-photo img{width:100%;height:100%;object-fit:contain;object-position:top}
.shop-back{position:absolute;inset:0;opacity:0}
.shop-photo[data-swapped="true"] .shop-back{opacity:1}
.shop-photo button{position:absolute;inset-block-end:var(--sy-space-xs);inset-inline-end:var(--sy-space-xs);font-size:var(--sy-text-small)}
.shop-card h2{font-family:var(--sy-font-body);font-size:var(--sy-text-body);font-weight:var(--sy-weight-body);margin:0}
.shop-card h2 a{text-decoration:none}
.shop-card p{margin-block:var(--sy-space-xs);font-size:var(--sy-text-small)}
.shop-colours{display:flex;align-items:center;gap:var(--sy-space-xs)}
.shop-colours img{width:var(--sy-space-md);height:var(--sy-space-md);border-radius:var(--sy-radius-pill);object-fit:cover}
.shop-quote{display:inline-flex;align-items:center;min-height:var(--control-size-md);text-underline-offset:var(--sy-space-xs)}
[data-shop-more]{display:flex;margin:var(--sy-space-xl) auto}
[data-shop-more][hidden]{display:none}
.shop-b2b{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--sy-space-lg);padding:var(--sy-space-xl);margin-block-start:var(--sy-space-section-sm);background:var(--sy-color-surface);border:var(--sy-space-hair) solid var(--sy-color-hairline);border-radius:var(--sy-radius-card)}
@media(hover:hover) and (pointer:fine){.shop-photo:hover .shop-back{opacity:1}}
@media(max-width:1024px){.shop-filter-open:not([hidden]){display:inline-flex!important}.shop[data-enhanced="true"] .shop-layout>.shop-filters{display:none}.shop-filter-dialog .shop-facet-list{grid-template-columns:1fr}.shop{width:calc(100% - 2 * var(--sy-space-gutter-md))}.shop-layout{grid-template-columns:minmax(0,1fr)}.shop-facet-list{grid-template-columns:repeat(3,minmax(0,1fr))}.shop-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:600px){.shop{width:calc(100% - 2 * var(--sy-space-gutter-mobile))}.shop-grid{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:var(--sy-space-xs)}.shop-facet-list{grid-template-columns:repeat(2,minmax(0,1fr))}.shop-toolbar{align-items:start;flex-direction:column}.shop-toolbar label{align-self:end}.shop-b2b{padding:var(--sy-space-lg)}}
</style>
