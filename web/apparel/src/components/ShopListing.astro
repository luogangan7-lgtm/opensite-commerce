---
/** Store listing owns facets, URL state, pagination and accessible filtering.
 * Depends on static catalog and owner MOQ facts; consumed by collections routes; no client requests or inferred facts.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { products, categories } from '../data/catalog';
import { shopFacts, shopFacets, featuredStyles, colourFamilies, colourHex, type Family } from '../data/shop';
import { shopCustomMoq, shopReadyMoq } from '../data/owner-facts';
import ProductCard from './ProductCard.astro';
import { dictionaries, pageLocale, type Key } from '../i18n';
interface Props { category?: string }
const { category } = Astro.props;
const locale = pageLocale(Astro.url), t = dictionaries[locale];
const catalog = featuredStyles(products);
const items = category ? products.filter(p => p.category === category) : catalog;
const choices: Record<string,string[]> = Object.fromEntries(shopFacets.map(key => [key, [...new Set(items.flatMap(p => shopFacts(p)[key]))].sort()]));
const label = (key: string) => t[`cp-shop/${key}` as Key];
const categoryKeys:Record<string,Key>={apparel:'cp-shop/figma-0033','cotton430-hoodie':'cp-shop/figma-0034','crew-fleece':'cp-shop/figma-0035','hoodie-set':'cp-shop/figma-0036','zip-ups-jackets':'cp-shop/figma-0037'};
// Both navigation and checkbox options use the catalog category source and reviewed copy.
choices.category = Object.keys(categories);
// Colour facets are customer-facing families, ordered by catalog product count (descending).
choices.colour = colourFamilies.filter(family => items.some(p => shopFacts(p).colour.includes(family)));
const categoryLabel=(value:string)=>t[categoryKeys[value] || value as Key];
const colourLabel=(family:string)=>t[`cp-shop/colour-${family}` as Key];
const facetLabel = (key: string, value: string) => t[`cp-shop/${key}-${value}` as Key] || value;
---
<div class="shop" data-shop data-products={JSON.stringify(items)} data-count-template={label(category ? 'category-count' : 'count')}>
 <div class="shop-title"><p>{t['cp-shop/figma-0022']}</p><h1>{category ? categoryLabel(category) : label('all')}</h1>{!category && <p>{t['cp-shop/figma-0024']}</p>}</div>
 <nav class="shop-tabs" aria-label={t.collections}>
  <a href={getRelativeLocaleUrl(locale, '/collections/')} aria-current={!category ? 'page' : undefined}>{label('any')}</a>
  {Object.keys(categories).map(key => <a href={getRelativeLocaleUrl(locale, `/collections/${key}/`)} aria-current={category === key ? 'page' : undefined}>{categoryLabel(key)}</a>)}
 </nav>
 <div class="shop-layout">
 <dialog class="shop-filter-dialog" data-shop-filter-dialog aria-label={label('filters')}><form method="dialog" class="shop-dialog-heading"><h2>{label('filters')}</h2><button aria-label={t.menuClose}>{t.menuClose}</button></form></dialog><details class="shop-filters" open><h2 class="shop-filters-heading">{label('filters')}</h2><summary>{label('filters')}</summary>
 <div class="shop-facet-list">{shopFacets.map(key => <fieldset><legend>{label(key)}</legend><div class="shop-options">{choices[key].map((v:string) => <label class:list={['shop-option',{'shop-colour-option':key==='colour'}]}>
 <input type="checkbox" data-shop-facet={key} value={v} />
 {key==='colour' && <span class="shop-swatch" style={`--shop-swatch:${colourHex[v as Family]}`} aria-hidden="true" />}
 <span class="shop-option-text" data-shop-category-label={key==='category' ? '' : undefined}>{key === 'category' ? categoryLabel(v) : key === 'fleece' ? (v === 'yes' ? label('fleece') : t['cp6.filter-unlined']) : key==='colour' ? colourLabel(v) : key==='fit'&&v==='oversized' ? t['cp-shop/figma-0042'] : key==='fabric'&&v==='cotton' ? t['cp-shop/figma-0044'] : key==='fabric'&&v==='polyester' ? t['cp-shop/figma-0045'].split('/').at(-1)?.trim() : facetLabel(key, v)}</span>
 </label>)}</div></fieldset>)}
 <p>{t['cp-shop/figma-0050']}</p><div class="shop-facet-actions"><button type="button" data-shop-clear>{t['cp6.copy/clear-filters']}</button><button type="button" class="shop-all-styles" data-shop-all-styles>{label('all')}</button></div></div>
 </details>
 <div class="shop-results">
 <div class="shop-toolbar"><p data-shop-count role="status" aria-live="polite">{label(category ? 'category-count' : 'count').replace('{shown}',String(items.length)).replace('{total}',String(items.length))}</p><div class="shop-toolbar-controls"><button type="button" class="shop-filter-open" data-shop-filter-open hidden><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M6 10h8M8 15h4" /></svg><span>{label('filters')}</span><span class="shop-filter-count" data-shop-filter-count hidden>0</span></button><label class="shop-sort"><span>{label('sort')}</span><select data-shop-sort aria-label={label('sort')}><option value="featured">{locale==='en'?label('featured'):t['cp-shop/figma-0052']}</option><option value="code">{label('code')}</option></select><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5" /></svg></label></div></div>
 <div class="shop-grid">{items.map(product => <ProductCard product={product} listing />)}</div>
 <div data-shop-empty hidden><h2>{t['cp6.copy/no-styles-match-these-filters']}</h2><p>{t['cp6.copy/try-removing-a-filter-or-request-a-style-tha']}</p></div>
 {!category && <p class="shop-shown" data-shop-shown role="status" hidden />}
 <button type="button" data-shop-more hidden>{label('more')}</button>
 </div></div>
 <aside class="shop-b2b"><div><h2>{t['cp-shop/figma-0055']}</h2><p>{t['cp-shop/figma-0057']}</p><div class="shop-terms"><p class="shop-owner-ready">{shopReadyMoq(locale)}</p><p class="shop-owner-custom">{shopCustomMoq(locale)}</p><a href={getRelativeLocaleUrl(locale,'/sampling/')}>{t.samples}</a><span>EXW / FOB</span></div></div><a class="button" href={getRelativeLocaleUrl(locale, '/contact/') + '#rfq-form'}>{t.request} <span aria-hidden="true">→</span></a></aside>
</div>
<script>
import { pageSize, selectStyles, setShopQuery, shopFacets, type ShopFacet } from '../data/shop';
import type { Product } from '../data/catalog';
for (const root of document.querySelectorAll<HTMLElement>('[data-shop]')) {
 const items: Product[] = JSON.parse(root.dataset.products!);
 const grid = root.querySelector<HTMLElement>('.shop-grid')!;
 const tiles = new Map([...root.querySelectorAll<HTMLElement>('[data-shop-card]')].map(el => [el.dataset.shopCard!, el]));
 const more = root.querySelector<HTMLButtonElement>('[data-shop-more]')!;
 const facets = [...root.querySelectorAll<HTMLInputElement>('[data-shop-facet]')];
 const filterOpen = root.querySelector<HTMLButtonElement>('[data-shop-filter-open]')!;
 const dialog = root.querySelector<HTMLDialogElement>('[data-shop-filter-dialog]')!;
 const filters = root.querySelector<HTMLDetailsElement>('.shop-filters')!;
 const anchor = document.createComment('filters'); filters.before(anchor);
 filterOpen.hidden = false; root.dataset.enhanced = 'true';
 filterOpen.addEventListener('click', () => { dialog.append(filters); filters.open = true; dialog.showModal(); });
 dialog.addEventListener('close', () => { anchor.after(filters); filterOpen.focus(); });
 const sort = root.querySelector<HTMLSelectElement>('[data-shop-sort]')!;
 let limit = pageSize;
 function render() {
  const q = new URLSearchParams(location.search), selected = selectStyles(items,q);
  for (const el of tiles.values()) el.hidden = true;
  selected.forEach((p,index) => { const el = tiles.get(p.slug)!; grid.append(el); el.hidden = index >= limit; });
  for (const el of facets) el.checked = q.getAll(el.dataset.shopFacet!).includes(el.value);
  const count = shopFacets.reduce((n,key)=>n+q.getAll(key).length,0), badge=root.querySelector<HTMLElement>('[data-shop-filter-count]')!;
  badge.textContent=String(count); badge.hidden=count===0;
  sort.value = q.get('sort') === 'code' ? 'code' : 'featured';
  const countTemplate = root.dataset.countTemplate!.replace('{total}', String(selected.length));
  root.querySelector<HTMLElement>('[data-shop-count]')!.textContent = countTemplate.replace('{shown}', String(selected.length));
  const shown = root.querySelector<HTMLElement>('[data-shop-shown]');
  if (shown) {
   shown.textContent = countTemplate.replace('{shown}', String(Math.min(limit, selected.length)));
   shown.hidden = selected.length <= limit;
  }
  root.querySelector<HTMLElement>('[data-shop-empty]')!.hidden = selected.length !== 0;
  more.hidden = selected.length <= limit;
 }
 function update(key: ShopFacet | 'sort', value: string | string[]) {
  const url = new URL(location.href); url.search = setShopQuery(url.searchParams,key,value).toString();
  history.pushState(null,'',url); limit = pageSize; render();
 }
 for (const el of facets) el.addEventListener('change', () => update(el.dataset.shopFacet as ShopFacet,facets.filter(input=>input.dataset.shopFacet===el.dataset.shopFacet&&input.checked).map(input=>input.value)));
 sort.addEventListener('change', () => update('sort',sort.value));
 more.addEventListener('click', () => { limit += pageSize; render(); });
 root.querySelector('[data-shop-clear]')!.addEventListener('click', () => {
  const url = new URL(location.href); for (const key of [...shopFacets,'sort']) url.searchParams.delete(key);
  history.pushState(null,'',url); limit = pageSize; render();
 });
 root.querySelector('[data-shop-all-styles]')!.addEventListener('click', () => {
  const url = new URL(location.href); for (const key of [...shopFacets,'sort']) url.searchParams.delete(key);
  if (dialog.open) dialog.close();
  history.pushState(null,'',url); limit = pageSize; render();
 });
 addEventListener('popstate', () => { limit = pageSize; render(); }); render();
}
</script>
<style>
.shop{width:min(calc(100% - 2 * var(--sy-space-gutter-lg)),calc(var(--sy-layout-desktop) - 2 * var(--sy-space-gutter-lg)));margin-inline:auto;padding-block:var(--sy-space-lg);color:var(--sy-color-ink)}
.shop-title{display:grid;gap:var(--sy-space-sm);margin-block-end:var(--sy-space-lg)}.shop-title p{margin:0}.shop-title p:first-child{font-size:var(--sy-text-eyebrow)}
.shop-title h1{font-size:var(--sy-text-h2);font-weight:var(--sy-weight-body);line-height:1.3;margin:0}
.shop-tabs{display:flex;flex-wrap:nowrap;padding-block:var(--sy-space-md);gap:var(--sy-space-md);overflow-x:auto;margin-block-end:var(--sy-space-xl);border-block-end:var(--sy-space-hair) solid var(--sy-color-hairline)}
.shop-tabs a{display:inline-flex;align-items:center;min-height:var(--control-size-md);white-space:nowrap;flex-shrink:0;font-size:var(--sy-text-small);padding:var(--sy-space-sm) var(--sy-space-md);text-decoration:none;border-radius:var(--sy-radius-pill)}
.shop-tabs [aria-current]:not(:first-child){background:var(--sy-color-accent);color:var(--sy-color-on-accent);box-shadow:none}
.shop-tabs [aria-current]{background:var(--sy-color-surface-alt);color:var(--sy-color-ink);box-shadow:inset 0 0 0 var(--sy-space-hair) var(--sy-color-border)}
.shop-layout{display:grid;grid-template-columns:calc(9 * var(--sy-space-grid-x)) minmax(0,1fr);gap:var(--sy-space-xl)}
.shop-filter-open{display:none!important}.shop-filter-dialog{width:min(100%,var(--sy-layout-mobile));max-width:100%;max-height:90dvh;padding:var(--sy-space-lg);border:var(--sy-space-hair) solid var(--sy-color-border);border-radius:var(--sy-radius-card);background:var(--sy-color-canvas);color:var(--sy-color-ink)}.shop-filter-dialog::backdrop{background:var(--sy-color-overlay)}.shop-filter-dialog .shop-filters{display:block}.shop-filter-dialog .shop-filters>summary{display:none}.shop-filters{align-self:start;border:0;padding:0}
.shop-filters summary{min-height:var(--control-size-md);cursor:pointer}
.shop-filters-heading{display:none}
@media(min-width:768px){.shop-layout>.shop-filters>.shop-filters-heading{display:block;font-family:var(--sy-font-body);font-size:var(--sy-text-small);font-weight:var(--sy-weight-body);margin:0 0 var(--sy-space-xs)}.shop-layout>.shop-filters>summary{display:none}}
.shop-facet-list{display:grid;gap:var(--sy-space-lg)}
.shop-facet-list fieldset{min-width:0;margin:0;padding:0;border:0}
.shop-facet-list legend{padding:0;margin-block-end:var(--sy-space-xs);font-size:var(--sy-text-small)}
.shop-options{display:grid;gap:var(--sy-space-2xs)}
.shop-option{display:flex;align-items:center;gap:var(--sy-space-sm);min-height:var(--control-size-md);padding:var(--sy-space-2xs) var(--sy-space-sm);border:0;border-radius:var(--sy-radius-input);font-size:var(--sy-text-small);cursor:pointer}
.shop-option:has(:checked){background:var(--sy-color-surface-alt)}
.shop-option input{appearance:none;flex:none;width:calc(var(--sy-space-sm) + var(--sy-space-xs));height:calc(var(--sy-space-sm) + var(--sy-space-xs));margin:0;padding:0;border:var(--sy-space-hair) solid var(--sy-color-border);border-radius:calc(var(--sy-space-2xs) + var(--sy-space-hair));background:var(--sy-color-surface)}
.shop-option input:checked{background:var(--sy-color-ink)}
.shop-option input:checked::after{content:'';display:block;width:100%;height:100%;background:var(--sy-color-surface);clip-path:polygon(20% 48%,40% 68%,80% 25%,90% 35%,40% 85%,10% 58%)}
.shop-option:focus-within{outline:calc(2 * var(--sy-space-hair)) solid var(--sy-color-ink);outline-offset:var(--sy-space-2xs)}
.shop-option-text{flex:1;min-width:0;overflow-wrap:anywhere}
.shop-colour-option{position:relative}
.shop-colour-option input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
.shop-swatch{flex:none;width:calc(var(--sy-space-sm) + var(--sy-space-xs));height:calc(var(--sy-space-sm) + var(--sy-space-xs));border-radius:var(--sy-radius-pill);background:var(--shop-swatch);box-shadow:inset 0 0 0 var(--sy-space-hair) var(--sy-color-border)}
.shop-colour-option:has(:checked) .shop-swatch{outline:calc(2 * var(--sy-space-hair)) solid var(--sy-color-ink);outline-offset:0}
.shop button{border-width:var(--sy-space-hair);border-radius:var(--sy-radius-control);background:var(--sy-color-surface);border-color:var(--sy-color-border);color:var(--sy-color-ink);padding:var(--sy-space-sm) var(--sy-space-md);min-height:var(--control-size-md);font-weight:var(--sy-weight-body)}
.shop button:hover{background:var(--sy-color-placeholder)}
.shop-facet-actions{display:flex;align-items:center;gap:var(--sy-space-xs)}
.shop .shop-all-styles{flex:1;background:var(--sy-color-accent);color:var(--sy-color-on-accent);border-color:var(--sy-color-accent)}
.shop .shop-all-styles:hover{background:var(--sy-color-ink);border-color:var(--sy-color-ink)}
.shop-toolbar{display:flex;align-items:center;justify-content:space-between;gap:var(--sy-space-sm);margin-block-end:var(--sy-space-xl);background:var(--sy-color-canvas)}
.shop-toolbar>p{margin:0;font-size:var(--sy-text-small);flex:1;min-width:0}
.shop-toolbar-controls{display:flex;align-items:center;gap:var(--sy-space-xs)}
.shop-filter-open>span,.shop-sort>span{white-space:nowrap}
.shop-toolbar svg{flex:none;width:var(--sy-space-md);height:var(--sy-space-md);fill:none;stroke:currentColor;stroke-width:1.5}
.shop-sort{width:calc(6 * var(--sy-space-xl) + 2 * var(--sy-space-lg));display:flex;align-items:center;justify-content:center;gap:var(--sy-space-xs);min-height:var(--control-size-md);padding-inline:var(--sy-space-sm);border:var(--sy-space-hair) solid var(--sy-color-border);border-radius:var(--sy-radius-input);background:var(--sy-color-surface);font-size:var(--sy-text-small)}
.shop-sort select{appearance:none;width:auto;min-width:0;max-width:100%;border:0;padding:0;background:transparent;color:inherit;font:inherit;cursor:pointer}
.shop-sort svg{pointer-events:none}
.shop-filter-count{display:inline-flex;align-items:center;justify-content:center;min-width:calc(var(--sy-space-sm) + var(--sy-space-xs));height:calc(var(--sy-space-sm) + var(--sy-space-xs));border-radius:var(--sy-radius-pill);background:var(--sy-color-ink);color:var(--sy-color-surface);font-size:var(--sy-text-small)}
.shop-filter-count[hidden]{display:none}
.shop-dialog-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--sy-space-sm)}
.shop-dialog-heading h2{font-family:var(--sy-font-body);font-size:var(--sy-text-h3-mobile);font-weight:var(--sy-weight-body);margin:0}
.shop-dialog-heading button{max-width:50%}
.shop-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--sy-space-sm) var(--sy-space-grid-x)}
.shop-shown{font-size:var(--sy-text-small);margin-block-start:var(--sy-space-sm)}
[data-shop-more]{display:flex;margin-block:var(--sy-space-xl)}
[data-shop-more][hidden]{display:none}
.shop-b2b{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--sy-space-lg);padding:var(--sy-space-gutter-lg);margin-inline:calc(-1 * var(--sy-space-gutter-lg));margin-block-start:var(--sy-space-section-sm);background:var(--sy-color-surface-alt);border:var(--sy-space-0);border-radius:var(--sy-radius-card)}
.shop-b2b h2{font-size:var(--sy-text-h2);margin:0}.shop-b2b p{margin-block:var(--sy-space-xs)}
.shop-terms{display:flex;flex-wrap:wrap;align-items:center;gap:var(--sy-space-xs)}
.shop-terms p{margin:0}.shop-terms > :not(:last-child)::after{content:" /";margin-inline-start:var(--sy-space-2xs)}
@media(max-width:1024px){
 .shop-title h1{font-size:var(--sy-text-h2-mobile)}
 .shop-tabs{gap:var(--sy-space-xs);padding-block:0 var(--sy-space-xs);scrollbar-width:thin}
 .shop-tabs [aria-current]{order:-1}
 .shop-filter-open:not([hidden]){display:inline-flex!important}
 .shop[data-enhanced="true"] .shop-layout>.shop-filters{display:none}
 .shop-filter-dialog .shop-facet-list{grid-template-columns:1fr}
 .shop-layout{grid-template-columns:minmax(0,1fr)}
 .shop-facet-list{grid-template-columns:repeat(3,minmax(0,1fr))}
 .shop-grid{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:calc(var(--sy-space-grid-x) + var(--sy-space-sm))}
 .shop-toolbar{display:grid;gap:var(--sy-space-sm)}
 .shop-toolbar-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:min(100%,calc(var(--sy-layout-mobile) - 2 * var(--sy-space-gutter-mobile)))}
 .shop-sort,.shop .shop-filter-open{width:auto;border-radius:var(--sy-radius-pill);justify-content:center}
 .shop-filter-open{gap:var(--sy-space-xs);padding-block:0!important;padding-inline:var(--sy-space-sm)!important;font-size:var(--sy-text-small)}
 .shop-sort select{min-width:0}
 .shop-b2b h2{font-size:var(--sy-text-h3-mobile)}
 .shop-b2b>.button{width:100%;justify-content:center}
}
@media(max-width:600px){
 .shop{width:calc(100% - 2 * var(--sy-space-gutter-mobile))}
 .shop-tabs{margin-block-end:var(--sy-space-sm)}
 .shop-grid{column-gap:var(--sy-space-xs)}
 .shop-facet-list{grid-template-columns:1fr}
 .shop-toolbar{position:sticky;inset-block-start:0;z-index:2}
 .shop-b2b{padding:var(--sy-space-gutter-mobile);margin-inline:calc(-1 * var(--sy-space-gutter-mobile))}
}
</style>
