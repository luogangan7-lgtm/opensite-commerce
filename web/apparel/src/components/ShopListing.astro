.shop-options{display:grid;gap:var(--sy-space-2xs)}
.shop-option{display:flex;align-items:center;gap:var(--sy-space-sm);min-height:var(--control-size-md);padding:var(--sy-space-2xs) var(--sy-space-sm);border:var(--sy-space-hair) solid var(--sy-color-hairline);border-radius:var(--sy-radius-input);background:var(--sy-color-surface);font-size:var(--sy-text-small);cursor:pointer}
.shop-option:has(:checked){background:var(--sy-color-surface-alt)}
.shop-option input{appearance:none;flex:none;width:calc(var(--sy-space-sm) + var(--sy-space-xs));height:calc(var(--sy-space-sm) + var(--sy-space-xs));margin:0;padding:0;border:var(--sy-space-hair) solid var(--sy-color-border);border-radius:calc(var(--sy-space-2xs) + var(--sy-space-hair));background:var(--sy-color-surface)}
.shop-option input:checked{background:var(--sy-color-ink)}
.shop-option input:checked::after{content:'';display:block;width:100%;height:100%;background:var(--sy-color-surface);clip-path:polygon(20% 48%,40% 68%,80% 25%,90% 35%,40% 85%,10% 58%)}
.shop-option:focus-within{outline:calc(2 * var(--sy-space-hair)) solid var(--sy-color-ink);outline-offset:var(--sy-space-2xs)}
.shop-option-text{flex:1;min-width:0;overflow-wrap:anywhere}
.shop-colour-option{position:relative}
.shop-colour-option input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
.shop-swatch{flex:none;width:calc(var(--sy-space-sm) + var(--sy-space-xs));height:calc(var(--sy-space-sm) + var(--sy-space-xs));border-radius:var(--sy-radius-pill);background:var(--shop-swatch)}
.shop-colour-option:has(:checked) .shop-swatch{outline:calc(2 * var(--sy-space-hair)) solid var(--sy-color-ink);outline-offset:0}
.shop button{border-width:var(--sy-space-hair);border-radius:var(--sy-radius-control);background:var(--sy-color-surface);border-color:var(--sy-color-border);color:var(--sy-color-ink);padding:var(--sy-space-sm) var(--sy-space-md);min-height:var(--control-size-md);font-weight:var(--sy-weight-body)}
.shop button:hover{background:var(--sy-color-placeholder)}
.shop-toolbar{display:flex;align-items:center;justify-content:space-between;gap:var(--sy-space-sm);margin-block-end:var(--sy-space-xl);background:var(--sy-color-canvas)}
.shop-toolbar>p{margin:0;font-size:var(--sy-text-small);flex:1;min-width:0}
.shop-toolbar-controls{display:flex;align-items:center;gap:var(--sy-space-xs)}
.shop-toolbar svg{flex:none;width:var(--sy-space-md);height:var(--sy-space-md);fill:none;stroke:currentColor;stroke-width:1.5}
.shop-sort{width:calc(6 * var(--sy-space-xl) + 2 * var(--sy-space-lg));display:flex;align-items:center;justify-content:center;gap:var(--sy-space-xs);min-height:var(--control-size-md);padding-inline:var(--sy-space-sm);border:var(--sy-space-hair) solid var(--sy-color-border);border-radius:var(--sy-radius-input);background:var(--sy-color-surface);font-size:var(--sy-text-small)}
.shop-sort select{appearance:none;width:auto;min-width:0;max-width:100%;border:0;padding:0;background:transparent;color:inherit;font:inherit;cursor:pointer}
.shop-sort svg{pointer-events:none}
.shop-filter-count{display:inline-flex;align-items:center;justify-content:center;min-width:calc(var(--sy-space-sm) + var(--sy-space-xs));height:calc(var(--sy-space-sm) + var(--sy-space-xs));border-radius:var(--sy-radius-pill);background:var(--sy-color-ink);color:var(--sy-color-surface);font-size:var(--sy-text-small)}
.shop-filter-count[hidden]{display:none}
.shop-dialog-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--sy-space-sm)}
.shop-dialog-heading h2{font-family:var(--sy-font-body);font-size:var(--sy-text-h3-mobile);font-weight:var(--sy-weight-body);margin:0}
.shop-dialog-heading button{max-width:50%}
.shop-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--sy-space-grid-y) var(--sy-space-grid-x)}
.shop-card{display:flex;flex-direction:column;align-self:stretch;min-width:0;background:var(--sy-color-surface);border-radius:var(--sy-radius-card);box-shadow:var(--sy-shadow-card);overflow:hidden;padding-block-end:var(--sy-space-sm)}
.shop-card[hidden]{display:none}
.shop-photo{position:relative;aspect-ratio:4/5;border-radius:var(--sy-radius-image);overflow:hidden;background:var(--sy-color-placeholder)}
.shop-photo a{display:block;height:100%}.shop-photo img{border-radius:var(--sy-radius-image)}
.shop-photo img{width:100%;height:100%;object-fit:contain;object-position:top}
.shop-back{position:absolute;inset:0;opacity:0}
.shop-photo[data-swapped="true"] .shop-back{opacity:1}
.shop-view-toggle-slot{position:absolute;inset-block-start:var(--sy-space-xs);inset-inline-end:var(--sy-space-xs);width:var(--control-size-md);height:var(--control-size-md)}
.shop-card h2{font-family:var(--sy-font-body);font-size:var(--sy-text-small);font-weight:var(--sy-weight-body);margin:0}
.shop-card h2 a{text-decoration:none}
.shop-card>h2,.shop-card>p{padding-inline:var(--sy-space-xs)}
.shop-card p{margin-block:var(--sy-space-xs);font-size:var(--sy-text-small)}
.shop-colours{display:flex;align-items:center;gap:var(--sy-space-xs)}
.shop-colours img{width:var(--sy-space-md);height:var(--sy-space-md);border-radius:var(--sy-radius-pill);object-fit:cover}
.shop-quote{font-size:var(--sy-text-small);margin-block-start:auto;display:inline-flex;align-items:center;min-height:var(--control-size-md);text-underline-offset:var(--sy-space-xs);border-radius:var(--sy-radius-pill);padding-inline:var(--sy-space-md)}
[data-shop-more]{display:flex;margin:var(--sy-space-xl) auto}
[data-shop-more][hidden]{display:none}
.shop-b2b{display:grid;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--sy-space-lg);padding:var(--sy-space-gutter-lg);margin-inline:calc(-1 * var(--sy-space-gutter-lg));margin-block-start:var(--sy-space-section-sm);background:var(--sy-color-surface-alt);border:var(--sy-space-0);border-radius:var(--sy-radius-card)}
.shop-b2b h2{font-size:var(--sy-text-h3);margin:0}.shop-b2b>p{margin:0}
.shop-terms{display:flex;flex-wrap:wrap;align-items:center;gap:var(--sy-space-lg)}
@media(hover:hover) and (pointer:fine){.shop-photo:hover .shop-back{opacity:1}}
@media(max-width:1024px){.shop-b2b{padding:var(--sy-space-gutter-md);margin-inline:calc(-1 * var(--sy-space-gutter-md))}.shop-tabs{padding-inline:var(--sy-space-md);mask-image:linear-gradient(to right,transparent,var(--sy-color-ink) var(--sy-space-md),var(--sy-color-ink) calc(100% - var(--sy-space-md)),transparent);mask-mode:alpha;scrollbar-width:thin;scroll-padding-inline:var(--sy-space-md)}.shop-filter-open:not([hidden]){display:inline-flex!important}.shop[data-enhanced="true"] .shop-layout>.shop-filters{display:none}.shop-filter-dialog .shop-facet-list{grid-template-columns:1fr}.shop{width:calc(100% - 2 * var(--sy-space-gutter-md))}.shop-layout{grid-template-columns:minmax(0,1fr)}.shop-facet-list{grid-template-columns:repeat(3,minmax(0,1fr))}.shop-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:600px){.shop-title h1{font-size:var(--sy-text-h2-mobile)}.shop-title p:first-child{font-size:var(--sy-text-eyebrow)}.shop-tabs{margin-block-end:var(--sy-space-sm)}.shop-b2b h2{font-size:var(--sy-text-h3-mobile)}.shop{width:calc(100% - 2 * var(--sy-space-gutter-mobile))}.shop-grid{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:var(--sy-space-xs)}.shop-facet-list{grid-template-columns:1fr}.shop-toolbar{position:sticky;inset-block-start:0;z-index:2;display:grid;gap:var(--sy-space-sm);padding-block:0}.shop-toolbar-controls{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.shop-sort{width:auto;border-radius:var(--sy-radius-control)}.shop-filter-open{gap:var(--sy-space-xs);padding-inline:var(--sy-space-sm)!important}.shop-sort select{width:100%}.shop-filter-open{font-size:var(--sy-text-small)}.shop-b2b{padding:var(--sy-space-gutter-mobile);margin-inline:calc(-1 * var(--sy-space-gutter-mobile))}.shop-terms{display:grid}}
</style>
