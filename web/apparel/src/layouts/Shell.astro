---
/** Apparel document and navigation; shares storefront semantic pattern and token/font packages.
 * Static-only: storefront Shell injects cart/account so cannot serve this quote-only surface. */
import '@opensite/design-tokens/css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/500.css';
import '../styles.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>{title} | Sourcyo Apparel</title><meta name="description" content="Explore apparel styles and send your sourcing requirements to Sourcyo Apparel." /></head>
<body><a class="skip" href="#content">Skip to content</a>
<header class="wrap"><a class="brand" href="/">Sourcyo Apparel</a><nav aria-label="Main"><a href="/collections/">Collections</a><a href="/about/#oem">OEM / ODM</a><a href="/about/">Factory</a><a href="/contact/">Contact</a></nav><a class="button" href="/contact/">Request a quote</a></header>
<main id="content"><slot /></main>
<footer><div class="wrap footer"><div><a class="brand" href="/">Sourcyo Apparel</a><p>Apparel for brands and wholesale buyers.</p></div><nav aria-label="Footer"><a href="/collections/">Collections</a><a href="/about/">About / Factory</a><a href="/contact/">Contact / RFQ</a></nav><p>Price, MOQ, lead time and sample cost: <span>Confirmed in quote</span></p></div></footer>
</body></html>
