---
/** Shared static document; Astro locale URLs, reciprocal alternates and navigation. All apparel pages consume this layout; desktop navigation stays unchanged. No backend state. */
import '@opensite/design-tokens/css';
// Frozen Figma families; Fontsource CSS self-hosts WOFF2 with font-display: swap.
import '@fontsource/literata/500.css';
import '@fontsource/literata/600.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/700.css';
import '@fontsource/noto-sans-arabic/400.css';
import '@fontsource/noto-sans-arabic/500.css';
import '@fontsource/noto-sans-arabic/600.css';
import '@fontsource/noto-sans-arabic/700.css';
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/noto-sans-sc/700.css';
import '../styles.css';
import BrandLogo from '../components/BrandLogo.astro';
import '../shell.css';
import CookieConsent from '../components/CookieConsent.astro';
import { analyticsScript, measurementId } from '../../analytics/config.mjs';
const gaSource = analyticsScript(measurementId(import.meta.env.PUBLIC_GA4_ID));
import { getRelativeLocaleUrl } from 'astro:i18n';
import { pageLocale, pagePath, dictionaries, locales, languageNames } from '../i18n';
import { isProduction } from '../../seo/mode';
import { seoOrigin, publishedPaths } from '../../seo/published';
import { page } from '../../seo/contract';
import { imageSrcset, heroSizes } from '../data/imagery';
interface Props { title: string; lcpImage?: string; lcpMobile?: string }
const { title, lcpImage, lcpMobile } = Astro.props;
const locale = pageLocale(Astro.url), t = dictionaries[locale], path = pagePath(Astro.url);
const href = (route: string) => getRelativeLocaleUrl(locale, route);
const closeMenu = t.menuClose;
const origin = new URL(seoOrigin);
const seo = publishedPaths.includes(path) ? page(seoOrigin, path, locale) : null;
const canonical = new URL(getRelativeLocaleUrl(locale, path), origin).href;
---
<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}><head><meta charset="UTF-8" /><link rel="icon" type="image/png" sizes="16x16" href="/brand/icon-16.png" /><link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" /><link rel="apple-touch-icon" sizes="180x180" href="/brand/icon-180.png" /><link rel="manifest" href="/brand/site.webmanifest" /><meta name="viewport" content="width=device-width, initial-scale=1" />{!isProduction && <meta name="robots" content="noindex" />}<title>{title} | Sourcyo Apparel</title><meta name="description" content={t.heroText} />
{lcpImage && <link rel="preload" as="image" href={lcpImage} media={lcpMobile ? '(min-width: 768px)' : undefined} fetchpriority="high" />}
{lcpMobile && <link rel="preload" as="image" href={lcpMobile} media="(max-width: 767px)" fetchpriority="high" />}
<link rel="canonical" href={canonical} /><meta property="og:title" content={`${title} | Sourcyo Apparel`} /><meta property="og:description" content={t.heroText} /><meta property="og:type" content={seo?.structuredData ? 'product' : 'website'} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="Sourcyo Apparel" />
{seo?.structuredData && <script type="application/ld+json" set:html={JSON.stringify(seo.structuredData)} />}
{path === '/' && <link rel="preload" as="image" fetchpriority="high" type="image/avif" imagesrcset={imageSrcset('home/hero', 'avif')} imagesizes={heroSizes} />}
{locales.map(lang => <link rel="alternate" hreflang={lang === 'zh' ? 'zh-Hans' : lang} href={new URL(getRelativeLocaleUrl(lang, path), origin)} />)}<link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('en', path), origin)} />{gaSource && <script is:inline set:html={gaSource} />}</head>
<body><a class="skip" href="#content">{t.skip}</a>
<header class:list={{ 'header-over-image': path === '/' }}><div class="wrap header-inner"><a class="brand" href={href('/')} aria-label={t.brandName}><BrandLogo variant={path === '/' ? 'reverse' : 'primary'} /></a><nav aria-label={t.mainNav}><a href={href('/')}>{t.shellHome}</a><a href={href('/collections/')}>{t.shellCollections}</a><a href={href('/oem-odm/')}>{t.navOem}</a><a href={href('/about/')}>{t.shellFactory}</a><a href={href('/contact/')}>{t.shellContact}</a></nav><a class="button" href={href('/contact/')}>{t.shellRequest}</a>
<details class="language-switcher"><summary aria-label={t.language}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg><bdi>{locale.toUpperCase()}</bdi></summary><nav aria-label={t.language}>{locales.map(lang => <a data-locale-link href={getRelativeLocaleUrl(lang, path)} lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} aria-current={lang === locale ? 'page' : undefined}>{languageNames[lang]}</a>)}</nav></details>
<button type="button" class="menu-toggle" data-menu-toggle aria-label={t.mainNav} aria-controls="mobile-navigation" aria-expanded="false"><span aria-hidden="true">☰</span></button>
<div class="menu-backdrop" data-menu-backdrop hidden>
<section id="mobile-navigation" role="dialog" aria-modal="true" aria-label={t.mainNav}>
<button type="button" data-menu-close aria-label={closeMenu}>×</button>
<nav aria-label={t.mainNav}><a href={href('/')} aria-current={path === '/' ? 'page' : undefined}>{t.shellHome}</a><a href={href('/collections/')} aria-current={path === '/collections/' ? 'page' : undefined}>{t.shellCollections}</a><a href={href('/oem-odm/')} aria-current={path === '/oem-odm/' ? 'page' : undefined}>{t.navOem}</a><a href={href('/about/')} aria-current={path === '/about/' ? 'page' : undefined}>{t.shellFactory}</a><a href={href('/contact/')} aria-current={path === '/contact/' ? 'page' : undefined}>{t.shellContact}</a></nav>
<a class="button" href={href('/contact/') + '#rfq-form'}>{t.shellRequest}</a>
<details class="mobile-languages"><summary>{t.language}: <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg><bdi>{locale.toUpperCase()}</bdi></summary><nav aria-label={t.language}>{locales.map(lang => <a data-locale-link href={getRelativeLocaleUrl(lang, path)} lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} aria-current={lang === locale ? 'page' : undefined}>{languageNames[lang]}</a>)}</nav></details>
</section></div></div></header>
<CookieConsent /><main id="content"><slot /></main>
<footer><div class="wrap footer">
<div><a class="brand" href={href('/')} aria-label={t.brandName}><BrandLogo variant="reverse" footer /></a><p>{t.footerText}</p></div>
<nav aria-label={t.footerNav}><h2>{t.footerNav}</h2><a href={href('/collections/')}>{t.shellCollections}</a><a href={href('/oem-odm/')}>{t.navOem}</a><a href={href('/about/')}>{t.shellFactory}</a><a href={href('/collections/')}>{t.footerSize}</a></nav>
<nav aria-label={t.footerHelp}><h2>{t.footerHelp}</h2><a href={href('/sampling/')}>{t.footerSampling}</a><a href={href('/shipping/')}>{t.footerShipping}</a><a href={href('/terms/')}>{t.footerTerms}</a><a href={href('/privacy/')}>{t.footerPrivacy}</a></nav>
<nav aria-label={t.shellContact}><h2>{t.shellContact}</h2><a href={href('/contact/')}>{t.shellRequest}</a><a href="https://wa.me/85270227648">{t.footerWhatsapp}</a><a href="mailto:sales@sourcyowear.com">{t.footerEmail}</a><a href={href('/contact/') + '#rfq-form'}>{t.footerContactForm}</a></nav>
</div><div class="wrap footer-legal"><span>{t.footerCopyright}</span><span>{t.footerNotice}</span></div></footer>
<a class="quote-float button" href={href('/contact/')}>{t.shellRequest}</a>
</body></html>

<script>
  // Carry only the HOME-BM allow-listed intent through static catalog/style/RFQ links.
  // No session persistence: leaving this journey removes the intent.
  const intentQuery = new URLSearchParams(location.search);
  if (intentQuery.getAll('intent').length === 1 && intentQuery.get('intent') === 'private-label') {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href]')) {
      const target = new URL(link.href, location.href);
      if (target.origin === location.origin && /^\/(?:zh\/|es\/|fr\/|de\/|pt\/|ru\/|ar\/)?(?:collections|products|contact)(?:\/|$)/.test(target.pathname)) {
        target.searchParams.set('intent', 'private-label'); link.href = target.href;
      }
    }
  }

  // Keep the header trigger available for pointer toggling; keyboard focus stays in the dialog.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]')!;
  const menu = document.querySelector<HTMLElement>('#mobile-navigation')!;
  const mobile = window.matchMedia('(max-width: 1100px)');
  const background = [...document.querySelectorAll<HTMLElement>('body > :not(header):not(script), .header-inner > :not(.menu-toggle):not(.menu-backdrop)')];
  const inertBefore = new Map<HTMLElement, boolean>();
  let previousOverflow = '';
  function closeMenu() {
    if (backdrop.hidden) return;
    backdrop.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    inertBefore.forEach((inert, element) => { element.inert = inert; });
    inertBefore.clear();
    document.body.style.overflow = previousOverflow;
    menu.querySelectorAll('details').forEach(details => { details.open = false; });
    if (mobile.matches) toggle.focus();
  }
  toggle.addEventListener('click', () => {
    if (!backdrop.hidden) { closeMenu(); return; }
    if (!mobile.matches) return;
    previousOverflow = document.body.style.overflow;
    background.forEach(element => { inertBefore.set(element, element.inert); element.inert = true; });
    backdrop.style.insetBlockStart = `${toggle.closest('header')!.getBoundingClientRect().bottom}px`;
    backdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    toggle.setAttribute('aria-expanded', 'true');
    menu.querySelector<HTMLAnchorElement>('nav a')!.focus();
  });
  menu.querySelector('[data-menu-close]')!.addEventListener('click', closeMenu);
  backdrop.addEventListener('click', event => { if (event.target === backdrop) closeMenu(); });
  document.addEventListener('keydown', event => {
    if (backdrop.hidden) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      const languages = menu.querySelector<HTMLDetailsElement>('.mobile-languages[open]');
      if (languages) {
        languages.open = false;
        languages.querySelector('summary')!.focus();
      } else closeMenu();
    }
    if (event.key === 'Tab') {
      const targets = [...menu.querySelectorAll<HTMLElement>('a, button, summary')].filter(element => element.checkVisibility());
      const first = targets[0], last = targets[targets.length - 1];
      if (event.shiftKey && (document.activeElement === first || !menu.contains(document.activeElement))) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && (document.activeElement === last || !menu.contains(document.activeElement))) { event.preventDefault(); first.focus(); }
    }
  });
  mobile.addEventListener('change', () => { if (!mobile.matches) closeMenu(); });
  // Static HTML has no request query; preserve it from the browser at navigation time.
  document.querySelectorAll<HTMLAnchorElement>('[data-locale-link]').forEach(link => {
    const target = new URL(link.href);
    target.search = window.location.search;
    target.hash = window.location.hash;
    link.href = target.pathname + target.search + target.hash;
  });
</script>
