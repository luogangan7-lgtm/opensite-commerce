{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "vite/client"
    ]
  },
  "include": [
    "web/admin",
    "packages",
    "scripts/frontend",
    "tests/frontend",
    "tests/e2e",
    "playwright.config.ts",
    "playwright.e2e.config.ts",
    "scripts/e2e",
    "web/storefront/src"
  ]
}
