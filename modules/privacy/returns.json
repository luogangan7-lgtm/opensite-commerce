{
  "version": 1,
  "module": "returns",
  "note": "Return reason, provider reference and immutable creation/receive JSON receipts may contain personal data, including derived copies. Scrubbing is an owner obligation requiring a controlled data-rights path through existing receipt guards; no erasure engine or financial-history mutation is implemented here.",
  "structures": {"ReturnReceipt": "Immutable command response snapshot, including reason and any derived personal/contact/provider fields from current, legacy, bulk or asynchronous producers.", "Sha256Digest": "Opaque 32-byte request/receive/refund-integrity digest; never raw reason, receipt, token or contact data."},
  "tables": {
    "returns": {
      "subject": {"tenant_key": "tenant_id", "identity_path": "returns.order_id -> orders.id -> orders.customer_id -> customers.id", "null_subject_policy": "Guest return inherits unverified order contact; arbitrary reason/provider/receipt text does not prove registered customer ownership."},
      "columns": {
        "tenant_id": {"classification": "operational"},
        "id": {"classification": "operational"},
        "order_id": {"classification": "operational"},
        "kind": {"classification": "operational"},
        "creation_key": {"classification": "operational"},
        "request_hash": {"classification": "secret_hash", "structure": "Sha256Digest", "export": "exclude"},
        "reason": {"classification": "personal", "erase": {"strategy": "scrub"}, "export": "include"},
        "currency": {"classification": "financial_non_contact"},
        "income_minor": {"classification": "financial_non_contact"},
        "tax_minor": {"classification": "financial_non_contact"},
        "shipping_minor": {"classification": "financial_non_contact"},
        "refund_minor": {"classification": "financial_non_contact"},
        "status": {"classification": "operational"},
        "order_version": {"classification": "operational"},
        "sealed": {"classification": "operational"},
        "restocked": {"classification": "operational"},
        "received_at": {"classification": "operational"},
        "creation_response": {"classification": "personal", "structure": "ReturnReceipt", "erase": {"strategy": "scrub"}, "export": "include"},
        "receive_response": {"classification": "personal", "structure": "ReturnReceipt", "erase": {"strategy": "scrub"}, "export": "include"},
        "receive_key": {"classification": "operational"},
        "receive_hash": {"classification": "secret_hash", "structure": "Sha256Digest", "export": "exclude"},
        "refund_key": {"classification": "operational"},
        "refund_hash": {"classification": "secret_hash", "structure": "Sha256Digest", "export": "exclude"},
        "refund_expected_version": {"classification": "operational"},
        "provider_ref": {"classification": "personal", "erase": {"strategy": "scrub"}, "export": "include"},
        "payment_version": {"classification": "operational"},
        "income_account_id": {"classification": "operational"},
        "tax_account_id": {"classification": "operational"},
        "shipping_account_id": {"classification": "operational"},
        "cash_account_id": {"classification": "operational"},
        "ledger_transaction_id": {"classification": "operational"},
        "refunded_at": {"classification": "operational"},
        "created_at": {"classification": "operational"}
      }
    },
    "return_lines": {
      "subject": {"tenant_key": "tenant_id", "identity_path": "return_lines.order_id -> orders.id -> orders.customer_id -> customers.id", "null_subject_policy": "Guest return line inherits unverified order contact policy."},
      "columns": {
        "tenant_id": {"classification": "operational"},
        "id": {"classification": "operational"},
        "return_id": {"classification": "operational"},
        "order_id": {"classification": "operational"},
        "order_line_id": {"classification": "operational"},
        "shipment_line_id": {"classification": "operational"},
        "quantity": {"classification": "operational"},
        "income_minor": {"classification": "financial_non_contact"},
        "tax_minor": {"classification": "financial_non_contact"},
        "shipping_minor": {"classification": "financial_non_contact"}
      }
    }
  }
}
