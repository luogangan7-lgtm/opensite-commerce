# Copy to .env (gitignored) and replace EVERY password; single-line, >=24 chars.
POSTGRES_PASSWORD=replace_with_random_admin_password
OPENSITE_RUNTIME_DB_PASSWORD=replace_with_random_runtime_password
OPENSITE_AUTH_DB_PASSWORD=replace_with_random_auth_password
OPENSITE_CUSTOMER_AUTH_DB_PASSWORD=replace_with_random_customer_auth_password
OPENSITE_DOMAIN_DB_PASSWORD=replace_with_random_domain_password
OPENSITE_MEDIA_DB_PASSWORD=replace_with_random_media_password
OPENSITE_WORKER_DB_PASSWORD=replace_with_random_worker_password
OPENSITE_OUTBOX_DB_PASSWORD=replace_with_random_outbox_password
JOB_SIGNING_KEY=replace_with_independent_64_hex_characters
# Staff login: exact HTTPS origin of the admin UI and an independent 64-hex key.
OPENSITE_ADMIN_ORIGIN=https://admin.localhost
OPENSITE_AUTH_SIGNING_KEY=replace_with_independent_64_hex_characters
# Customer login: independent HTTPS origin and 32-128 random bytes, base64url.
OPENSITE_STOREFRONT_ORIGIN=https://store.localhost
OPENSITE_CUSTOMER_CSRF_SECRET=replace_with_independent_base64url_secret
JOB_TENANTS=
OPENSITE_DB=opensite
OPENSITE_API_PORT=8080
OPENSITE_WORKER_PORT=8081
OPENSITE_MAIL_PORT=8025
COMPOSE_PROJECT_NAME=opensite_local
